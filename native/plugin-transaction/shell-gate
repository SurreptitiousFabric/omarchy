#!/bin/bash
set -euo pipefail

fail() {
  printf 'omarchy-plugin-shell-gate: %s: %s\n' "$1" "$2" >&2
  exit 2
}

[[ $# -ge 1 ]] || fail usage 'expected action'
action=$1
shift

journal=""
gate=""
journal_sha=""
operation_binding=""
journal_schema=""
computed_operation_binding=""

helper=${OMARCHY_PLUGIN_TREE_HELPER:-/usr/lib/omarchy/plugin-tree}
state_root=${OMARCHY_PLUGIN_TRANSACTION_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/plugin-transactions-v1}
journal_validator=${OMARCHY_PLUGIN_JOURNAL_VALIDATOR:-${OMARCHY_PATH:?missing OMARCHY_PATH}/native/plugin-transaction/validate-journal.jq}
gate_validator=${OMARCHY_PLUGIN_GATE_VALIDATOR:-${OMARCHY_PATH:?missing OMARCHY_PATH}/native/plugin-transaction/validate-gate.jq}
[[ -x $helper ]] || fail unavailable-helper "$helper"
[[ -f $journal_validator && -f $gate_validator ]] || fail unavailable-validator "$state_root"
command -v jq >/dev/null 2>&1 || fail unavailable-jq jq

# Stage normally creates the shared Omarchy state parent while creating the
# candidate store. Shell startup may precede the first stage on a fresh system.
state_parent=${state_root%/*}
mkdir -p -- "$state_parent"
[[ -d $state_parent && ! -L $state_parent ]] || fail invalid-state-parent "$state_parent"
chmod 0700 -- "$state_parent"

valid_operation() { [[ $1 =~ ^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$ ]]; }
valid_plugin() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && $1 != *..* && $1 != omarchy.* ]]; }

validate_canonical() {
  local path=$1 validator=$2 key_name=$3 key_value=$4 size mode links canonical
  [[ -f $path && ! -L $path ]] || return 1
  read -r size mode links < <(stat -c '%s %a %h' -- "$path")
  (( size > 0 && size <= 1048576 )) && [[ $mode == 600 && $links == 1 ]] || return 1
  jq -e --arg "$key_name" "$key_value" -f "$validator" "$path" >/dev/null 2>&1 || return 1
  canonical=$(mktemp "${TMPDIR:-/tmp}/omarchy-gate-canonical.XXXXXX")
  jq -cS . "$path" >"$canonical"
  cmp -s "$path" "$canonical"
  local result=$?
  rm -f -- "$canonical"
  return "$result"
}

release_locks() {
  if [[ -n ${lock_input_fd:-} ]]; then
    exec {lock_input_fd}>&-
    lock_input_fd=
  fi
  if [[ -n ${lock_holder_pid:-} ]]; then
    wait "$lock_holder_pid" 2>/dev/null || true
    lock_holder_pid=
  fi
}
trap release_locks EXIT

lock_operation_then_plugin() {
  local operation_id=$1 plugin_id=$2 ready status read_status
  coproc GATE_LOCK_HOLDER {
    "$helper" ordered-lock "$state_root" "$operation_id" "$plugin_id"
  }
  lock_holder_pid=$GATE_LOCK_HOLDER_PID
  lock_output_fd=${GATE_LOCK_HOLDER[0]}
  lock_input_fd=${GATE_LOCK_HOLDER[1]}
  if IFS= read -r -t 5 ready <&"$lock_output_fd"; then
    :
  else
    read_status=$?
    kill "$lock_holder_pid" 2>/dev/null || true
    set +e
    wait "$lock_holder_pid"
    status=$?
    set -e
    lock_holder_pid=
    exec {lock_output_fd}<&-
    exec {lock_input_fd}>&-
    lock_input_fd=
    (( status == 3 )) && fail plugin-gated-by-another-operation "$plugin_id"
    (( read_status == 142 )) && fail operation-plugin-lock-timeout "$plugin_id"
    fail operation-plugin-lock-failed "$plugin_id"
  fi
  exec {lock_output_fd}<&-
  [[ $ready == locked-operation-then-plugin ]] || fail operation-plugin-lock-failed "$plugin_id"
}

load_operation() {
  local operation_id=$1 plugin_id=$2 allow_terminal=${3:-0}
  valid_operation "$operation_id" || fail invalid-operation-id "$operation_id"
  valid_plugin "$plugin_id" || fail invalid-plugin-id "$plugin_id"
  "$helper" state-init "$state_root"
  lock_operation_then_plugin "$operation_id" "$plugin_id"
  "$helper" journal-sync "$state_root" "$operation_id"
  journal="$state_root/journals/$operation_id.journal"
  validate_canonical "$journal" "$journal_validator" operation_id "$operation_id" || fail invalid-operation-journal "$operation_id"
  [[ $(jq -r .pluginId "$journal") == "$plugin_id" ]] || fail operation-mismatch "$operation_id"
  journal_schema=$(jq -r .schema "$journal")
  case $journal_schema in
    omarchy-plugin-transaction-journal/v1)
      [[ $(jq -r .state "$journal") == STAGED ]] || fail operation-mismatch "$operation_id"
      journal_sha=$(sha256sum "$journal" | cut -d' ' -f1)
      operation_binding=""
      ;;
    omarchy-plugin-transaction-journal/v2)
      operation_binding=$(jq -r .operationBindingSha256 "$journal")
      [[ $operation_binding =~ ^[0-9a-f]{64}$ ]] || fail invalid-operation-binding "$operation_id"
      computed_operation_binding=$(jq -cS '{operationId,pluginId,
        operation:.normalizedRequest.facts.operation,
        requestDigest:.normalizedRequest.digest,
        candidateExpected:.candidate.expected,
        candidateObserved:.candidate.observed,
        candidateSlot:.candidate.completedSlot,
        expectedActive:.normalizedRequest.facts.expectedActive,
        destination:.normalizedRequest.facts.destination}' "$journal" |
        "$helper" domain-hash omarchy-plugin-transaction-operation-binding/v1 2>/dev/null) ||
        fail invalid-operation-binding "$operation_id"
      [[ $computed_operation_binding == "$operation_binding" ]] || fail operation-binding-mismatch "$operation_id"
      case $(jq -r .state "$journal") in
        ABORTED|REJECTED) fail operation-mismatch "$operation_id" ;;
        COMMITTED|ROLLED_BACK)
          [[ $allow_terminal == 1 ]] || fail operation-mismatch "$operation_id"
          ;;
      esac
      ;;
    *) fail unsupported-journal-schema "$operation_id" ;;
  esac
  gate="$state_root/gates/$plugin_id.gate"
}

load_gate() {
  local operation_id=$1 plugin_id=$2 allow_terminal=${3:-0}
  load_operation "$operation_id" "$plugin_id" "$allow_terminal"
  "$helper" gate-sync "$state_root"
  [[ -e $gate || -L $gate ]] || fail gate-missing "$plugin_id"
  validate_canonical "$gate" "$gate_validator" plugin_id "$plugin_id" || fail gate-state-invalid "$plugin_id"
  [[ $(jq -r .operationId "$gate") == "$operation_id" ]] || fail plugin-gated-by-another-operation "$plugin_id"
  if [[ $journal_schema == omarchy-plugin-transaction-journal/v1 ]]; then
    [[ $(jq -r .operationJournalSha256 "$gate") == "$journal_sha" ]] || fail operation-journal-changed "$operation_id"
  else
    [[ $(jq -r .schema "$gate") == omarchy-plugin-transaction-gate/v2 &&
       $(jq -r .operationBindingSha256 "$gate") == "$operation_binding" ]] || fail operation-binding-mismatch "$operation_id"
  fi
}

terminal_gate_safe() {
  local path=$1 operation_id plugin_id terminal_state journal journal_authority gate_authority
  [[ -f $path && ! -L $path ]] || return 1
  [[ $(jq -r '.schema // ""' "$path") == omarchy-plugin-transaction-gate/v2 &&
      $(jq -r '.state // ""' "$path") == TERMINAL_RECEIPT ]] || return 1
  operation_id=$(jq -r '.operationId // ""' "$path")
  plugin_id=$(jq -r '.pluginId // ""' "$path")
  terminal_state=$(jq -r '.terminalReceipt.intendedJournalState // ""' "$path")
  [[ $operation_id =~ ^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$ ]] || return 1
  valid_plugin "$plugin_id" || return 1
  [[ ${path##*/} == "$plugin_id.gate" ]] || return 1
  [[ $terminal_state == COMMITTED || $terminal_state == ROLLED_BACK ]] || return 1
  # A visible terminal journal is not startup authority until the existing
  # operation and plugin locks are held and the journals directory has been
  # synchronized by the native held-reader.
  lock_operation_then_plugin "$operation_id" "$plugin_id" || return 1
  journal=$("$helper" journal-read-held "$state_root" "$operation_id" 2>/dev/null) || {
    release_locks
    return 1
  }
  gate_authority=$("$helper" gate-read-held "$state_root" "$plugin_id" 2>/dev/null) || {
    release_locks
    return 1
  }
  [[ "$gate_authority" == "$(cat -- "$path")" ]] || {
    release_locks
    return 1
  }
  computed_operation_binding=$(printf '%s' "$journal" | jq -cS '{operationId,pluginId,
    operation:.normalizedRequest.facts.operation,requestDigest:.normalizedRequest.digest,
    candidateExpected:.candidate.expected,candidateObserved:.candidate.observed,
    candidateSlot:.candidate.completedSlot,expectedActive:.normalizedRequest.facts.expectedActive,
    destination:.normalizedRequest.facts.destination}' |
    "$helper" domain-hash omarchy-plugin-transaction-operation-binding/v1 2>/dev/null) || {
    release_locks
    return 1
  }
  jq -e --arg operation_id "$operation_id" --arg terminal "$terminal_state" \
    --arg binding "$(jq -r '.operationBindingSha256' "$path")" \
    --arg plugin "$plugin_id" --arg computed "$computed_operation_binding" --argjson receipt "$(jq -c .terminalReceipt "$path")" \
    -f "$journal_validator" <<<"$journal" >/dev/null 2>&1 || { release_locks; return 1; }
  jq -e --arg terminal "$terminal_state" --arg binding "$(jq -r '.operationBindingSha256' "$path")" \
    --arg plugin "$plugin_id" --arg computed "$computed_operation_binding" --argjson receipt "$(jq -c .terminalReceipt "$path")" \
    '.state == $terminal and .operationBindingSha256 == $binding and $computed == $binding and .pluginId == $plugin and .terminalReceipt == $receipt' <<<"$journal" >/dev/null 2>&1
  local result=$?
  release_locks
  return $result
}

replace_gate() {
  local plugin_id=$1 input=$2 transition=$3
  "$helper" gate-replace "$state_root" "$plugin_id" "$input" "$transition"
  "$helper" gate-sync "$state_root"
  validate_canonical "$state_root/gates/$plugin_id.gate" "$gate_validator" plugin_id "$plugin_id" || fail gate-state-invalid "$plugin_id"
}

emit_gate_result() {
  local status=$1
  jq -cS --arg status "$status" \
    '{status:$status,state:.state,operationBindingSha256:(.operationBindingSha256 // null),operationJournalSha256:(.operationJournalSha256 // null),gate:.}' "$gate"
}

case $action in
  projection-digest)
    [[ $# == 1 && ${#1} -le 1048576 ]] || fail usage 'projection-digest BASE64'
    printf '%s' "$1" | base64 -d 2>/dev/null | sha256sum | awk '{print "sha256:" $1}'
    ;;
  inventory)
    [[ $# == 0 ]] || fail usage inventory
    "$helper" state-init "$state_root"
    if ! "$helper" gate-sync "$state_root"; then
      jq -cn '{schema:"omarchy-plugin-gate-inventory/v1",status:"global-unreadable",gates:[]}'
      exit 0
    fi
    inventory=$(mktemp "${TMPDIR:-/tmp}/omarchy-gate-inventory.XXXXXX")
    printf '[]\n' >"$inventory"
    global=ok
    shopt -s nullglob dotglob
    for path in "$state_root/gates"/*; do
      name=${path##*/}
      if [[ $name =~ ^([A-Za-z0-9][A-Za-z0-9._-]*)\.gate$ ]]; then
        plugin_id=${BASH_REMATCH[1]}
        if ! valid_plugin "$plugin_id"; then
          global=global-unreadable
          continue
        fi
        # A pathname-visible gate is only a candidate for inventory.  The
        # native reader synchronizes the existing gates directory and pins
        # the complete record before any state is accepted below.
        gate_authority=$($helper gate-read "$state_root" "$plugin_id" 2>/dev/null || true)
        if [[ -n $gate_authority ]] && printf '%s' "$gate_authority" | jq -e --arg plugin_id "$plugin_id" -f "$gate_validator" >/dev/null 2>&1; then
          terminal_safe=false
          terminal_gate_safe "$path" && terminal_safe=true
          if [[ $terminal_safe != true ]]; then
            next=$(mktemp "${TMPDIR:-/tmp}/omarchy-gate-inventory-next.XXXXXX")
            jq --argjson gate "$gate_authority" '. + [{pluginId:$gate.pluginId,valid:true,record:$gate}]' "$inventory" >"$next"
            mv -- "$next" "$inventory"
          fi
        else
          next=$(mktemp "${TMPDIR:-/tmp}/omarchy-gate-inventory-next.XXXXXX")
          jq --arg plugin "$plugin_id" '. + [{pluginId:$plugin,valid:false,record:null}]' "$inventory" >"$next"
          mv -- "$next" "$inventory"
        fi
      elif [[ $name == .*\.tmp.* ]]; then
        : # Interrupted temporary records are never authoritative.
      else
        global=global-unreadable
      fi
    done
    # A terminal journal without its matching durable terminal receipt is
    # still blocking.  Keep this per-plugin so an unrelated plugin can
    # continue, while an unidentifiable/corrupt journal fails the inventory
    # closed for the whole authority set.
    for path in "$state_root/journals"/*.journal; do
      [[ -e $path || -L $path ]] || continue
      name=${path##*/}
      [[ $name =~ ^([0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})\.journal$ ]] || {
        global=global-unreadable
        continue
      }
      operation_id=${BASH_REMATCH[1]}
      journal_authority=$($helper journal-read-locked "$state_root" "$operation_id" 2>/dev/null) || {
        global=global-unreadable
        continue
      }
      if ! printf '%s' "$journal_authority" | jq -e --arg operation_id "$operation_id" -f "$journal_validator" >/dev/null 2>&1; then
        global=global-unreadable
        continue
      fi
      journal_state=$(printf '%s' "$journal_authority" | jq -r '.state // ""')
      [[ $journal_state == COMMITTED || $journal_state == ROLLED_BACK ]] || continue
      plugin_id=$(printf '%s' "$journal_authority" | jq -r '.pluginId // ""')
      if ! valid_plugin "$plugin_id"; then
        global=global-unreadable
        continue
      fi
      gate_path=$state_root/gates/$plugin_id.gate
      if [[ ! -f $gate_path ]] || ! terminal_gate_safe "$gate_path"; then
        next=$(mktemp "${TMPDIR:-/tmp}/omarchy-gate-inventory-next.XXXXXX")
        jq --arg plugin "$plugin_id" '. + [{pluginId:$plugin,valid:false,record:null}]' "$inventory" >"$next"
        mv -- "$next" "$inventory"
      fi
    done
    jq -cn --arg status "$global" --slurpfile gates "$inventory" \
      '{schema:"omarchy-plugin-gate-inventory/v1",status:$status,gates:$gates[0]}'
    rm -f -- "$inventory"
    ;;
  install)
    [[ $# == 2 ]] || fail usage 'install OPERATION_ID PLUGIN_ID'
    operation_id=$1; plugin_id=$2
    load_operation "$operation_id" "$plugin_id"
    if [[ $journal_schema == omarchy-plugin-transaction-journal/v2 && $(jq -r .state "$journal") != COMMIT_PREPARED ]]; then
      fail operation-state-mismatch "$operation_id"
    fi
    "$helper" gate-sync "$state_root"
    if [[ -e $gate || -L $gate ]]; then
      validate_canonical "$gate" "$gate_validator" plugin_id "$plugin_id" || fail gate-state-invalid "$plugin_id"
      replace_terminal_gate=false
      if [[ $(jq -r .operationId "$gate") != "$operation_id" ]]; then
        previous_gate_operation_id=$(jq -r .operationId "$gate")
        # The current operation already owns the plugin lock from
        # load_operation.  Terminal-pair validation must acquire the old
        # operation lock before that same plugin lock, so release the current
        # ordered locks for this bounded validation and then reacquire and
        # revalidate the current operation before replacing the receipt.
        release_locks
        if ! terminal_gate_safe "$gate"; then
          fail plugin-gated-by-another-operation "$plugin_id"
        fi
        load_operation "$operation_id" "$plugin_id"
        "$helper" gate-sync "$state_root"
        [[ -e $gate && ! -L $gate ]] || fail plugin-gated-by-another-operation "$plugin_id"
        validate_canonical "$gate" "$gate_validator" plugin_id "$plugin_id" || fail gate-state-invalid "$plugin_id"
        [[ $(jq -r .operationId "$gate") == "$previous_gate_operation_id" ]] || fail plugin-gated-by-another-operation "$plugin_id"
        # A validated terminal receipt paired with its terminal journal is a
        # completed, non-blocking handoff.  It is safe to replace it with the
        # new operation's gate; its old binding must not be compared with the
        # new operation below.
        replace_terminal_gate=true
      fi
      if [[ $replace_terminal_gate != true ]]; then
        if [[ $journal_schema == omarchy-plugin-transaction-journal/v1 ]]; then
          [[ $(jq -r .operationJournalSha256 "$gate") == "$journal_sha" ]] || fail operation-journal-changed "$operation_id"
        else
          [[ $(jq -r .schema "$gate") == omarchy-plugin-transaction-gate/v2 && $(jq -r .operationBindingSha256 "$gate") == "$operation_binding" ]] || fail operation-binding-mismatch "$operation_id"
        fi
        if [[ $journal_schema == omarchy-plugin-transaction-journal/v2 ]]; then
          existing_gate_state=$(jq -r .state "$gate")
          case $existing_gate_state in
            GATED|UNLOAD_ACKNOWLEDGED)
              emit_gate_result already-gated
              exit 0
              ;;
            *)
              fail operation-state-mismatch "$operation_id"
              ;;
          esac
        fi
        emit_gate_result already-gated
        exit 0
      fi
    fi
    input=$(mktemp "${TMPDIR:-/tmp}/omarchy-gate-record.XXXXXX")
    if [[ $journal_schema == omarchy-plugin-transaction-journal/v2 ]]; then
      jq -cS --arg binding "$operation_binding" '
      {schema:"omarchy-plugin-transaction-gate/v2",operationId:.operationId,pluginId:.pluginId,
       operationBindingSha256:$binding,state:"GATED",
       expected:{tree:.candidate.observed,destination:.normalizedRequest.facts.destination,
         targetRole:"candidate",configurationSource:.normalizedRequest.facts.expectedConfiguration.source,
         referenceProjection:.normalizedRequest.facts.expectedConfiguration.referenceProjection,
         referenceState:.normalizedRequest.facts.expectedConfiguration.referenceState,
         referencePolicy:.normalizedRequest.facts.expectedConfiguration.referencePolicy},
       unload:"pending",
       rescan:{expectedTree:null,generation:null,observedTree:null,outcome:"not-requested",scanEpoch:null,shellInstance:null,sourceDirectory:null,targetRole:"none"},
       release:{configurationEpoch:null,generation:null,outcome:"not-requested",shellInstance:null},
       rollback:{targetRole:"none",target:null,outcome:"not-requested"},
       terminalReceipt:{state:"not-requested",intendedJournalState:null,operationBindingSha256:null,operationId:null,pluginId:null,targetRole:"none",target:null,shellInstance:null,generation:null,scanEpoch:null,configurationEpoch:null,outcome:"not-requested"}}' "$journal" >"$input"
    else
      jq -cS --arg journalSha "$journal_sha" '
      {schema:"omarchy-plugin-transaction-gate/v1",operationId:.operationId,pluginId:.pluginId,
       operationJournalSha256:$journalSha,state:"GATED",
       expected:{tree:.candidate.observed,destination:.normalizedRequest.facts.destination,
         configurationSource:.normalizedRequest.facts.expectedConfiguration.source,
         referenceProjection:.normalizedRequest.facts.expectedConfiguration.referenceProjection,
         referenceState:.normalizedRequest.facts.expectedConfiguration.referenceState,
         referencePolicy:.normalizedRequest.facts.expectedConfiguration.referencePolicy},
       unload:"pending",
       rescan:{expectedTree:null,generation:null,observedTree:null,outcome:"not-requested",scanEpoch:null,shellInstance:null,sourceDirectory:null},
       release:{configurationEpoch:null,generation:null,outcome:"not-requested",shellInstance:null}}' "$journal" >"$input"
    fi
    replace_gate "$plugin_id" "$input" gate-install
    rm -f -- "$input"
    gate="$state_root/gates/$plugin_id.gate"
    emit_gate_result gate-installed
    ;;
  acknowledge-unload)
    [[ $# == 3 ]] || fail usage 'acknowledge-unload OPERATION_ID PLUGIN_ID SHELL_INSTANCE'
    operation_id=$1; plugin_id=$2; shell_instance=$3
    [[ -n $shell_instance && ${#shell_instance} -le 128 ]] || fail invalid-shell-instance "$shell_instance"
    load_gate "$operation_id" "$plugin_id"
    if [[ $journal_schema == omarchy-plugin-transaction-journal/v2 ]]; then
      case $(jq -r .state "$journal") in
        COMMIT_PREPARED|GATED_RESCAN_COMPLETED|RELEASE_PENDING|ROLLBACK_STARTED) ;;
        *) fail operation-state-mismatch "$operation_id" ;;
      esac
    fi
    state=$(jq -r .state "$gate")
    if [[ $state == UNLOAD_ACKNOWLEDGED ]]; then
      emit_gate_result already-unloaded
      exit 0
    fi
    [[ $state == GATED ]] || fail operation-state-mismatch "$operation_id"
    input=$(mktemp "${TMPDIR:-/tmp}/omarchy-gate-record.XXXXXX")
    jq -cS '.state="UNLOAD_ACKNOWLEDGED" | .unload="acknowledged"' "$gate" >"$input"
    replace_gate "$plugin_id" "$input" gate-unload-acknowledged
    rm -f -- "$input"
    gate="$state_root/gates/$plugin_id.gate"
    emit_gate_result gate-installed-unload-acknowledged
    ;;
  acknowledge-rescan)
    [[ $# == 6 ]] || fail usage 'acknowledge-rescan OPERATION_ID PLUGIN_ID SHELL_INSTANCE GENERATION SCAN_EPOCH SOURCE_DIRECTORY'
    operation_id=$1; plugin_id=$2; shell_instance=$3; generation=$4; scan_epoch=$5; source_directory=${6%/}
    [[ $generation =~ ^[0-9]+$ && $scan_epoch =~ ^[0-9]+$ && -n $shell_instance && ${#shell_instance} -le 128 ]] || fail invalid-rescan-binding "$plugin_id"
    load_gate "$operation_id" "$plugin_id"
    if [[ $journal_schema == omarchy-plugin-transaction-journal/v2 && $(jq -r .state "$journal") != LIVE_TREE_EXCHANGED ]]; then
      fail operation-state-mismatch "$operation_id"
    fi
    state=$(jq -r .state "$gate")
    if [[ $state == RESCAN_ACKNOWLEDGED ]]; then
      [[ $(jq -r .rescan.shellInstance "$gate") == "$shell_instance"
        && $(jq -r .rescan.generation "$gate") == "$generation"
        && $(jq -r .rescan.scanEpoch "$gate") == "$scan_epoch"
        && $(jq -r .rescan.sourceDirectory "$gate") == "$source_directory" ]] || fail gated-rescan-mismatch "$plugin_id"
      emit_gate_result gated-rescan-already-complete
      exit 0
    fi
    [[ $state == UNLOAD_ACKNOWLEDGED ]] || fail unload-incomplete "$plugin_id"
    destination=$(jq -r .expected.destination "$gate")
    [[ $source_directory == "$destination" ]] || fail registry-source-mismatch "$plugin_id"
    expected=$(jq -r .expected.tree "$gate")
    [[ -d $destination && ! -L $destination ]] || fail expected-live-tree-missing "$destination"
    observed=$("$helper" identity "$destination")
    [[ $observed == "$expected" ]] || fail expected-live-tree-mismatch "$plugin_id"
    input=$(mktemp "${TMPDIR:-/tmp}/omarchy-gate-record.XXXXXX")
    if [[ $journal_schema == omarchy-plugin-transaction-journal/v2 ]]; then
      jq -cS --arg instance "$shell_instance" --argjson generation "$generation" --argjson scanEpoch "$scan_epoch" \
        --arg source "$source_directory" --arg tree "$expected" \
        '.state="RESCAN_ACKNOWLEDGED" | .rescan={expectedTree:$tree,generation:$generation,observedTree:$tree,outcome:"completed",scanEpoch:$scanEpoch,shellInstance:$instance,sourceDirectory:$source,targetRole:"candidate"}' "$gate" >"$input"
    else
      jq -cS --arg instance "$shell_instance" --argjson generation "$generation" --argjson scanEpoch "$scan_epoch" \
        --arg source "$source_directory" --arg tree "$expected" \
        '.state="RESCAN_ACKNOWLEDGED" | .rescan={expectedTree:$tree,generation:$generation,observedTree:$tree,outcome:"completed",scanEpoch:$scanEpoch,shellInstance:$instance,sourceDirectory:$source}' "$gate" >"$input"
    fi
    replace_gate "$plugin_id" "$input" gate-rescan-acknowledged
    rm -f -- "$input"
    gate="$state_root/gates/$plugin_id.gate"
    jq -cS '{status:"gated-rescan-complete",state:.state,operationJournalSha256:.operationJournalSha256,
      shellInstance:.rescan.shellInstance,generation:.rescan.generation,scanEpoch:.rescan.scanEpoch,
      sourceDirectory:.rescan.sourceDirectory,tree:.rescan.observedTree,execution:"not-observed",gate:.}' "$gate"
    ;;
  retarget-rollback)
    [[ $# == 5 ]] || fail usage 'retarget-rollback OPERATION_ID PLUGIN_ID SHELL_INSTANCE TARGET_ROLE TARGET_IDENTITY'
    operation_id=$1; plugin_id=$2; shell_instance=$3; target_role=$4; target_identity=$5
    [[ -n $shell_instance && ${#shell_instance} -le 128 ]] || fail invalid-shell-instance "$plugin_id"
    [[ $target_role == prior-tree || $target_role == absence ]] || fail invalid-rollback-target "$plugin_id"
    if [[ $target_role == prior-tree ]]; then
      [[ $target_identity =~ ^omarchy-runtime-tree-sha256-v1:[0-9a-f]{64}$ ]] || fail invalid-rollback-target "$plugin_id"
    else
      [[ -z $target_identity ]] || fail invalid-rollback-target "$plugin_id"
    fi
    load_gate "$operation_id" "$plugin_id"
    [[ $journal_schema == omarchy-plugin-transaction-journal/v2 && $(jq -r .state "$journal") == ROLLBACK_STARTED ]] || fail operation-state-mismatch "$operation_id"
    [[ $(jq -r .state "$gate") == UNLOAD_ACKNOWLEDGED || $(jq -r .state "$gate") == RESCAN_ACKNOWLEDGED ]] || fail unload-incomplete "$plugin_id"
    input=$(mktemp "${TMPDIR:-/tmp}/omarchy-gate-record.XXXXXX")
    if [[ $target_role == absence ]]; then
      jq -cS --arg role "$target_role" \
        '.state="UNLOAD_ACKNOWLEDGED" | .expected.targetRole=$role | .expected.tree=null | .rollback={targetRole:$role,target:{state:"absent",identity:null},outcome:"pending"} | .rescan={expectedTree:null,generation:null,observedTree:null,outcome:"not-requested",scanEpoch:null,shellInstance:null,sourceDirectory:null,targetRole:"none"} | .release={configurationEpoch:null,generation:null,outcome:"not-requested",shellInstance:null} | .terminalReceipt={state:"not-requested",intendedJournalState:null,operationBindingSha256:null,operationId:null,pluginId:null,targetRole:"none",target:null,shellInstance:null,generation:null,scanEpoch:null,configurationEpoch:null,outcome:"not-requested"}' "$gate" >"$input"
    else
      jq -cS --arg role "$target_role" --arg tree "$target_identity" \
        '.state="UNLOAD_ACKNOWLEDGED" | .expected.targetRole=$role | .expected.tree=$tree | .rollback={targetRole:$role,target:{state:"present",identity:$tree},outcome:"pending"} | .rescan={expectedTree:null,generation:null,observedTree:null,outcome:"not-requested",scanEpoch:null,shellInstance:null,sourceDirectory:null,targetRole:"none"} | .release={configurationEpoch:null,generation:null,outcome:"not-requested",shellInstance:null} | .terminalReceipt={state:"not-requested",intendedJournalState:null,operationBindingSha256:null,operationId:null,pluginId:null,targetRole:"none",target:null,shellInstance:null,generation:null,scanEpoch:null,configurationEpoch:null,outcome:"not-requested"}' "$gate" >"$input"
    fi
    replace_gate "$plugin_id" "$input" rollback-gate-retarget
    rm -f -- "$input"
    gate="$state_root/gates/$plugin_id.gate"
    emit_gate_result rollback-targeted
    ;;
  acknowledge-rollback-rescan)
    [[ $# == 6 ]] || fail usage 'acknowledge-rollback-rescan OPERATION_ID PLUGIN_ID SHELL_INSTANCE GENERATION SCAN_EPOCH SOURCE_DIRECTORY'
    operation_id=$1; plugin_id=$2; shell_instance=$3; generation=$4; scan_epoch=$5; source_directory=${6%/}
    [[ $generation =~ ^[0-9]+$ && $scan_epoch =~ ^[0-9]+$ && -n $shell_instance && ${#shell_instance} -le 128 ]] || fail invalid-rescan-binding "$plugin_id"
    load_gate "$operation_id" "$plugin_id"
    [[ $journal_schema == omarchy-plugin-transaction-journal/v2 && $(jq -r .state "$journal") == ROLLBACK_STARTED ]] || fail operation-state-mismatch "$operation_id"
    [[ $(jq -r .state "$gate") == UNLOAD_ACKNOWLEDGED ]] || fail unload-incomplete "$plugin_id"
    destination=$(jq -r .expected.destination "$gate")
    [[ $source_directory == "$destination" ]] || fail registry-source-mismatch "$plugin_id"
    target_role=$(jq -r .expected.targetRole "$gate")
    expected=$(jq -r '.expected.tree // ""' "$gate")
    if [[ $target_role == absence ]]; then
      [[ ! -e $destination && ! -L $destination ]] || fail expected-rollback-absence-missing "$plugin_id"
    else
      [[ -d $destination && ! -L $destination ]] || fail expected-rollback-tree-missing "$plugin_id"
      observed=$($helper identity "$destination")
      [[ $observed == "$expected" ]] || fail expected-rollback-tree-mismatch "$plugin_id"
    fi
    input=$(mktemp "${TMPDIR:-/tmp}/omarchy-gate-record.XXXXXX")
    if [[ $target_role == absence ]]; then
      jq -cS --arg instance "$shell_instance" --argjson generation "$generation" --argjson scanEpoch "$scan_epoch" --arg source "$source_directory" \
        '.state="RESCAN_ACKNOWLEDGED" | .rescan={expectedTree:null,generation:$generation,observedTree:null,outcome:"completed",scanEpoch:$scanEpoch,shellInstance:$instance,sourceDirectory:$source,targetRole:"absence"} | .rollback.outcome="pending"' "$gate" >"$input"
    else
      jq -cS --arg instance "$shell_instance" --argjson generation "$generation" --argjson scanEpoch "$scan_epoch" --arg source "$source_directory" --arg tree "$expected" \
        '.state="RESCAN_ACKNOWLEDGED" | .rescan={expectedTree:$tree,generation:$generation,observedTree:$tree,outcome:"completed",scanEpoch:$scanEpoch,shellInstance:$instance,sourceDirectory:$source,targetRole:"prior-tree"} | .rollback.outcome="pending"' "$gate" >"$input"
    fi
    replace_gate "$plugin_id" "$input" rollback-rescan-acknowledged
    rm -f -- "$input"
    gate="$state_root/gates/$plugin_id.gate"
    emit_gate_result rollback-rescan-complete
    ;;
  authorize-release)
    [[ $# == 9 ]] || fail usage 'authorize-release OPERATION_ID PLUGIN_ID SHELL_INSTANCE GENERATION EPOCH SOURCE_KIND SOURCE_IDENTITY PROJECTION REFERENCE_STATE'
    operation_id=$1; plugin_id=$2; shell_instance=$3; generation=$4; epoch=$5
    source_kind=$6; source_identity=$7; projection=$8; reference_state=$9
    [[ $generation =~ ^[0-9]+$ && $epoch =~ ^[0-9]+$ ]] || fail invalid-release-binding "$plugin_id"
    load_gate "$operation_id" "$plugin_id"
    if [[ $journal_schema == omarchy-plugin-transaction-journal/v2 && $(jq -r .state "$journal") != RELEASE_PENDING ]]; then
      fail operation-state-mismatch "$operation_id"
    fi
    state=$(jq -r .state "$gate")
    if [[ $state == RELEASE_AUTHORIZED ]]; then
      [[ $(jq -r .release.shellInstance "$gate") == "$shell_instance"
        && $(jq -r .release.generation "$gate") == "$generation"
        && $(jq -r .release.configurationEpoch "$gate") == "$epoch" ]] || fail stale-release-binding "$plugin_id"
    elif [[ $state == RESCAN_ACKNOWLEDGED ]]; then
      [[ $(jq -r .rescan.shellInstance "$gate") == "$shell_instance" ]] || fail stale-shell-instance "$plugin_id"
      [[ $(jq -r .rescan.generation "$gate") == "$generation" ]] || fail stale-registry-generation "$plugin_id"
    else
      fail gated-rescan-missing "$plugin_id"
    fi
    [[ $(jq -r .expected.configurationSource.kind "$gate") == "$source_kind" && $(jq -r .expected.configurationSource.identity "$gate") == "$source_identity" ]] || fail release-configuration-source-mismatch "$plugin_id"
    policy=$(jq -r .expected.referencePolicy "$gate")
    if [[ $policy == require-unreferenced ]]; then
      [[ $projection == sha256:d1b70136d50b542b1c5646d3235047314bd09a2074c5e73e6c2389b7c3209432 && $reference_state == unreferenced ]] || fail release-reference-mismatch "$plugin_id"
    else
      [[ $(jq -r .expected.referenceProjection "$gate") == "$projection" && $(jq -r .expected.referenceState "$gate") == "$reference_state" ]] || fail release-reference-mismatch "$plugin_id"
    fi
    destination=$(jq -r .expected.destination "$gate")
    [[ -d $destination && ! -L $destination ]] || fail expected-live-tree-missing "$destination"
    observed=$("$helper" identity "$destination")
    [[ $observed == "$(jq -r .expected.tree "$gate")" ]] || fail expected-live-tree-mismatch "$plugin_id"
    if [[ $state == RELEASE_AUTHORIZED ]]; then
      emit_gate_result release-already-authorized
      exit 0
    fi
    input=$(mktemp "${TMPDIR:-/tmp}/omarchy-gate-record.XXXXXX")
    jq -cS --arg instance "$shell_instance" --argjson generation "$generation" --argjson epoch "$epoch" \
      '.state="RELEASE_AUTHORIZED" | .release={configurationEpoch:$epoch,generation:$generation,outcome:"authorized",shellInstance:$instance}' "$gate" >"$input"
    replace_gate "$plugin_id" "$input" gate-release-authorized
    rm -f -- "$input"
    gate="$state_root/gates/$plugin_id.gate"
    jq -cS '{status:"release-authorized",state:.state,operationJournalSha256:.operationJournalSha256,
      configurationEpoch:.release.configurationEpoch,execution:"not-observed",gate:.}' "$gate"
    ;;
  authorize-rollback-release)
    [[ $# == 9 ]] || fail usage 'authorize-rollback-release OPERATION_ID PLUGIN_ID SHELL_INSTANCE GENERATION EPOCH SOURCE_KIND SOURCE_IDENTITY PROJECTION REFERENCE_STATE'
    operation_id=$1; plugin_id=$2; shell_instance=$3; generation=$4; epoch=$5
    source_kind=$6; source_identity=$7; projection=$8; reference_state=$9
    [[ $generation =~ ^[0-9]+$ && $epoch =~ ^[0-9]+$ ]] || fail invalid-release-binding "$plugin_id"
    load_gate "$operation_id" "$plugin_id"
    [[ $journal_schema == omarchy-plugin-transaction-journal/v2 && $(jq -r .state "$journal") == ROLLBACK_STARTED ]] || fail operation-state-mismatch "$operation_id"
    state=$(jq -r .state "$gate")
    [[ $state == RESCAN_ACKNOWLEDGED || $state == RELEASE_AUTHORIZED ]] || fail rollback-rescan-missing "$plugin_id"
    [[ $(jq -r .rescan.shellInstance "$gate") == "$shell_instance" &&
       $(jq -r .rescan.generation "$gate") == "$generation" ]] || fail stale-release-binding "$plugin_id"
    [[ $(jq -r .expected.configurationSource.kind "$gate") == "$source_kind" && $(jq -r .expected.configurationSource.identity "$gate") == "$source_identity" ]] || fail release-configuration-source-mismatch "$plugin_id"
    policy=$(jq -r .expected.referencePolicy "$gate")
    if [[ $policy == require-unreferenced ]]; then
      [[ $projection == sha256:d1b70136d50b542b1c5646d3235047314bd09a2074c5e73e6c2389b7c3209432 && $reference_state == unreferenced ]] || fail release-reference-mismatch "$plugin_id"
    else
      [[ $(jq -r .expected.referenceProjection "$gate") == "$projection" && $(jq -r .expected.referenceState "$gate") == "$reference_state" ]] || fail release-reference-mismatch "$plugin_id"
    fi
    destination=$(jq -r .expected.destination "$gate")
    target_role=$(jq -r .expected.targetRole "$gate")
    expected=$(jq -r '.expected.tree // ""' "$gate")
    if [[ $target_role == absence ]]; then
      [[ ! -e $destination && ! -L $destination ]] || fail expected-rollback-absence-missing "$plugin_id"
    else
      [[ -d $destination && ! -L $destination ]] || fail expected-rollback-tree-missing "$plugin_id"
      observed=$($helper identity "$destination")
      [[ $observed == "$expected" ]] || fail expected-rollback-tree-mismatch "$plugin_id"
    fi
    if [[ $state == RELEASE_AUTHORIZED ]]; then
      emit_gate_result rollback-release-already-authorized
      exit 0
    fi
    input=$(mktemp "${TMPDIR:-/tmp}/omarchy-gate-record.XXXXXX")
    jq -cS --arg instance "$shell_instance" --argjson generation "$generation" --argjson epoch "$epoch" \
      '.state="RELEASE_AUTHORIZED" | .release={configurationEpoch:$epoch,generation:$generation,outcome:"authorized",shellInstance:$instance}' "$gate" >"$input"
    replace_gate "$plugin_id" "$input" rollback-release-authorized
    rm -f -- "$input"
    gate="$state_root/gates/$plugin_id.gate"
    jq -cS '{status:"rollback-release-authorized",state:.state,operationBindingSha256:.operationBindingSha256,configurationEpoch:.release.configurationEpoch,gate:.}' "$gate"
    ;;
  terminal-receipt)
    [[ $# == 3 ]] || fail usage 'terminal-receipt OPERATION_ID PLUGIN_ID COMMITTED|ROLLED_BACK'
    operation_id=$1; plugin_id=$2; intended_state=$3
    [[ $intended_state == COMMITTED || $intended_state == ROLLED_BACK ]] || fail invalid-terminal-state "$intended_state"
    load_gate "$operation_id" "$plugin_id"
    if [[ $intended_state == COMMITTED ]]; then
      [[ $journal_schema == omarchy-plugin-transaction-journal/v2 && $(jq -r .state "$journal") == RELEASE_PENDING ]] || fail operation-state-mismatch "$operation_id"
    else
      [[ $journal_schema == omarchy-plugin-transaction-journal/v2 && $(jq -r .state "$journal") == ROLLBACK_STARTED ]] || fail operation-state-mismatch "$operation_id"
    fi
    [[ $(jq -r .state "$gate") == RELEASE_AUTHORIZED ]] || fail release-not-authorized "$plugin_id"
    input=$(mktemp "${TMPDIR:-/tmp}/omarchy-gate-record.XXXXXX")
    target_role=$(jq -r .expected.targetRole "$gate")
    target_identity=$(jq -r '.expected.tree // ""' "$gate")
    jq -cS --arg intended "$intended_state" --arg binding "$operation_binding" --arg operationId "$operation_id" --arg pluginId "$plugin_id" \
      --arg role "$target_role" --arg tree "$target_identity" --arg instance "$(jq -r .release.shellInstance "$gate")" \
      --argjson generation "$(jq -r .release.generation "$gate")" --argjson scanEpoch "$(jq -r .rescan.scanEpoch "$gate")" \
      --argjson configurationEpoch "$(jq -r .release.configurationEpoch "$gate")" \
      '.state="TERMINAL_RECEIPT" | .terminalReceipt={state:"durable",intendedJournalState:$intended,operationBindingSha256:$binding,operationId:$operationId,pluginId:$pluginId,targetRole:$role,target:(if $role == "absence" then {state:"absent",identity:null} else {state:"present",identity:$tree} end),shellInstance:$instance,generation:$generation,scanEpoch:$scanEpoch,configurationEpoch:$configurationEpoch,outcome:(if $intended == "ROLLED_BACK" then "restored" else "authorized" end)}' "$gate" >"$input"
    replace_gate "$plugin_id" "$input" terminal-receipt
    rm -f -- "$input"
    gate="$state_root/gates/$plugin_id.gate"
    jq -cS '{status:"terminal-receipt-durable",state:.state,operationBindingSha256:.operationBindingSha256,terminalReceipt:.terminalReceipt,gate:.}' "$gate"
    ;;
  terminal-reconcile)
    [[ $# == 2 ]] || fail usage 'terminal-reconcile OPERATION_ID PLUGIN_ID'
    operation_id=$1; plugin_id=$2
    load_gate "$operation_id" "$plugin_id" 1
    state=$(jq -r .state "$journal")
    intended_state=$(jq -r '.terminalReceipt.intendedJournalState // ""' "$gate")
    [[ $(jq -r .state "$gate") == TERMINAL_RECEIPT ]] || fail terminal-receipt-missing "$plugin_id"
    if [[ $intended_state == COMMITTED ]]; then
      [[ $state == COMMITTED ]] || fail operation-state-mismatch "$operation_id"
    elif [[ $intended_state == ROLLED_BACK ]]; then
      [[ $state == ROLLED_BACK ]] || fail operation-state-mismatch "$operation_id"
    else
      fail terminal-receipt-invalid "$plugin_id"
    fi
    jq -e --arg operation "$operation_id" --arg plugin "$plugin_id" --arg intended "$intended_state" \
      '.terminalReceipt.operationId == $operation and .terminalReceipt.pluginId == $plugin and .terminalReceipt.intendedJournalState == $intended and .terminalReceipt.operationBindingSha256 == .operationBindingSha256 and .terminalReceipt.state == "durable"' "$gate" >/dev/null 2>&1 ||
      fail terminal-receipt-invalid "$plugin_id"
    jq -cS --arg intended "$intended_state" \
      '{status:"terminal-pair-valid",operationId:.operationId,pluginId:.pluginId,intendedJournalState:$intended,operationBindingSha256:.operationBindingSha256,terminalReceipt:.terminalReceipt,gate:.}' "$gate"
    ;;
  retain-release)
    [[ $# == 4 ]] || fail usage 'retain-release OPERATION_ID PLUGIN_ID SHELL_INSTANCE GENERATION'
    operation_id=$1; plugin_id=$2; shell_instance=$3; generation=$4
    [[ $generation =~ ^[0-9]+$ && -n $shell_instance && ${#shell_instance} -le 128 ]] || fail invalid-release-binding "$plugin_id"
    load_gate "$operation_id" "$plugin_id"
    if [[ $journal_schema == omarchy-plugin-transaction-journal/v2 ]]; then
      case $(jq -r .state "$journal") in
        GATED_RESCAN_COMPLETED|RELEASE_PENDING|ROLLBACK_STARTED) ;;
        *) fail operation-state-mismatch "$operation_id" ;;
      esac
    fi
    state=$(jq -r .state "$gate")
    if [[ $state == GATED ]]; then
      # Retaining release authority first re-establishes a blocking gate.  The
      # shell must complete its real lifecycle quiescence and call
      # acknowledge-unload separately; this action must never manufacture an
      # unload acknowledgement.
      emit_gate_result release-retained
      exit 0
    fi
    if [[ $state == TERMINAL_RECEIPT ]]; then
      # A terminal-receipt helper can fail after the receipt rename but before
      # the coordinator observes it.  Re-establish a blocking v2 gate and
      # clear the receipt evidence; the nonterminal journal remains the
      # authoritative handoff, and QML must still prove lifecycle quiescence.
      :
    elif [[ $state == UNLOAD_ACKNOWLEDGED ]]; then
      emit_gate_result release-retained
      exit 0
    elif [[ $state == RESCAN_ACKNOWLEDGED ]]; then
      [[ $(jq -r .rescan.shellInstance "$gate") == "$shell_instance"
        && $(jq -r .rescan.generation "$gate") == "$generation" ]] || fail stale-release-binding "$plugin_id"
    elif [[ $state == RELEASE_AUTHORIZED ]]; then
      [[ $(jq -r .release.shellInstance "$gate") == "$shell_instance"
        && $(jq -r .release.generation "$gate") == "$generation" ]] || fail stale-release-binding "$plugin_id"
    else
      fail release-not-authorized "$plugin_id"
    fi
    input=$(mktemp "${TMPDIR:-/tmp}/omarchy-gate-record.XXXXXX")
    if [[ $journal_schema == omarchy-plugin-transaction-journal/v2 ]]; then
      jq -cS '.state="GATED" | .unload="pending"
        | .rescan={expectedTree:null,generation:null,observedTree:null,outcome:"not-requested",scanEpoch:null,shellInstance:null,sourceDirectory:null,targetRole:"none"}
        | .release={configurationEpoch:null,generation:null,outcome:"not-requested",shellInstance:null}
        | .terminalReceipt={state:"not-requested",intendedJournalState:null,operationBindingSha256:null,operationId:null,pluginId:null,targetRole:"none",target:null,shellInstance:null,generation:null,scanEpoch:null,configurationEpoch:null,outcome:"not-requested"}' "$gate" >"$input"
    else
      jq -cS '.state="UNLOAD_ACKNOWLEDGED"
        | .rescan={expectedTree:null,generation:null,observedTree:null,outcome:"not-requested",scanEpoch:null,shellInstance:null,sourceDirectory:null}
        | .release={configurationEpoch:null,generation:null,outcome:"not-requested",shellInstance:null}' "$gate" >"$input"
    fi
    replace_gate "$plugin_id" "$input" gate-release-retained
    rm -f -- "$input"
    gate="$state_root/gates/$plugin_id.gate"
    emit_gate_result release-retained
    ;;
  *) fail usage "$action" ;;
esac
