#!/bin/bash

# omarchy:group=plugin
# omarchy:name=transaction
# omarchy:summary=Use the hidden versioned inert plugin transaction interface
# omarchy:hidden=true

set +x
set -euo pipefail
umask 077

export LC_ALL=C
export PATH=/usr/bin:/bin
unset BASH_XTRACEFD OMARCHY_PATH OMARCHY_SHELL_IPC_TIMEOUT
while IFS= read -r variable; do
  unset "$variable" || true
done < <(compgen -v OMARCHY_PLUGIN_ || true)

jq_bin=/usr/bin/jq
base64_bin=/usr/bin/base64
sha256_bin=/usr/bin/sha256sum
script_directory=$(/usr/bin/realpath -e -- "$(/usr/bin/dirname -- "${BASH_SOURCE[0]}")")
if [[ $script_directory == /usr/bin ]]; then
  package_root=/usr/share/omarchy
else
  package_root=$(/usr/bin/realpath -e -- "$script_directory/..")
fi
request_validator=$package_root/native/plugin-transaction/validate-request.jq
observation_validator=$package_root/native/plugin-transaction/validate-stage-observation.jq
journal_validator=$package_root/native/plugin-transaction/validate-journal.jq
gate_validator=$package_root/native/plugin-transaction/validate-gate.jq
stage_helper=$package_root/native/plugin-transaction/stage-candidate
shell_client=$package_root/bin/omarchy-shell
native_helper=$package_root/native/plugin-transaction/plugin-tree
if [[ ! -x $native_helper && $package_root == */share/omarchy ]]; then
  install_prefix=${package_root%/share/omarchy}
  [[ -n $install_prefix ]] || install_prefix=/
  native_helper=$install_prefix/lib/omarchy/plugin-tree
fi

request_protocol=""
request_action=""
request_operation_id=""
request_plugin_id=""
journal_input=""
stage_result_file=""
stage_result_read_fd=""
stage_result_write_fd=""
stage_stdout_file=""
stage_stderr_file=""
lock_read_fd=""
lock_write_fd=""
lock_pid=""
locks_held=0
readonly lock_timeout_seconds=5
authority_reason=""
authority_phase=pre
authority_observed_kind=""
authority_observed_identity=""
authority_observed_raw_hash=""
authority_observed_projection_hash=""
authority_observed_reference_state=""
authority_observed_epoch=-1
operation_kind=""
destination=""
active_state=""
active_identity=""
expected_candidate=""
expected_config_kind=""
expected_config_identity=""
expected_projection=""
expected_reference_state=""
reference_policy=""
candidate_path=""

cleanup() {
  [[ -z $journal_input ]] || /usr/bin/rm -f -- "$journal_input"
  [[ -z $stage_result_read_fd ]] || exec {stage_result_read_fd}<&- || true
  [[ -z $stage_result_write_fd ]] || exec {stage_result_write_fd}>&- || true
  [[ -z $stage_result_file ]] || /usr/bin/rm -f -- "$stage_result_file"
  [[ -z $stage_stdout_file ]] || /usr/bin/rm -f -- "$stage_stdout_file"
  [[ -z $stage_stderr_file ]] || /usr/bin/rm -f -- "$stage_stderr_file"
  [[ -z $lock_read_fd ]] || exec {lock_read_fd}<&- || true
  [[ -z $lock_write_fd ]] || exec {lock_write_fd}>&- || true
  [[ -z $lock_pid ]] || wait "$lock_pid" 2>/dev/null || true
  locks_held=0
}
trap cleanup EXIT

emit_error() {
  local response_status=$1 response_reason=$2 exit_code=$3
  local response_state=${4:-}
  "$jq_bin" -cnS \
    --arg protocol "$request_protocol" \
    --arg action "$request_action" \
    --arg operationId "$request_operation_id" \
    --arg pluginId "$request_plugin_id" \
    --arg state "$response_state" \
    --arg status "$response_status" \
    --arg reason "$response_reason" \
    '{protocol:(if $protocol == "" then null else $protocol end),
      action:(if $action == "" then null else $action end),
      operationId:(if $operationId == "" then null else $operationId end),
      pluginId:(if $pluginId == "" then null else $pluginId end),
      state:(if $state == "" then null else $state end),status:$status,reason:$reason}'
  printf 'omarchy-plugin-transaction: %s\n' "$response_reason" >&2
  exit "$exit_code"
}

native_run() {
  /usr/bin/env -i PATH="$PATH" LC_ALL=C "$native_helper" "$@"
}

json_field() {
  local filter=$1
  printf '%s' "$request" | "$jq_bin" -r "$filter"
}

validate_operation_token() {
  local padding padded_token decoded_length reencoded
  padding=$(( (4 - ${#operation_token} % 4) % 4 ))
  padded_token=${operation_token//-/+}
  padded_token=${padded_token//_/\/}
  padded_token+=$(printf '%*s' "$padding" '' | /usr/bin/tr ' ' '=')
  if ! decoded_length=$(printf '%s' "$padded_token" | "$base64_bin" -d 2>/dev/null | /usr/bin/wc -c); then
    unset padded_token
    return 1
  fi
  if ! reencoded=$(printf '%s' "$padded_token" | "$base64_bin" -d 2>/dev/null |
      "$base64_bin" -w0 | /usr/bin/tr '+/' '-_' | /usr/bin/tr -d '='); then
    unset padded_token reencoded
    return 1
  fi
  unset padded_token
  (( decoded_length >= 32 && decoded_length <= 128 )) || {
    unset reencoded
    return 1
  }
  [[ $reencoded == "$operation_token" ]] || {
    unset reencoded
    return 1
  }
  unset reencoded
}

validate_update_destination() {
  local candidate=$1 canonical parent name resolved
  [[ $candidate == /* && $candidate != *'//' &&
      $candidate != *$'\n'* && $candidate != *$'\r'* ]] || return 1
  canonical=$(/usr/bin/realpath -m -- "$candidate" 2>/dev/null) || return 1
  parent=$(/usr/bin/dirname -- "$canonical") || return 1
  name=$(/usr/bin/basename -- "$canonical") || return 1
  [[ $parent == "$discovery_dir" && -n $name && $name != . && $name != .. ]] || return 1
  if [[ -L $candidate ]]; then
    return 1
  fi
  if [[ -e $candidate ]]; then
    [[ -d $candidate ]] || return 1
    resolved=$(/usr/bin/realpath -e -- "$candidate" 2>/dev/null) || return 1
    [[ $resolved == "$canonical" ]] || return 1
  fi
  return 0
}

journal=""
journal_read_error=""
read_journal_with_action() {
  local read_action=${1:-journal-read-locked}
  local output canonical facts computed_digest stored_digest read_status
  if output=$(native_run "$read_action" "$state_root" "$request_operation_id" 2>&1); then
    if ! printf '%s' "$output" | "$jq_bin" -eS \
        --arg operation_id "$request_operation_id" -f "$journal_validator" >/dev/null 2>&1; then
      journal_read_error=invalid-state
      return 2
    fi
    if ! canonical=$(printf '%s' "$output" | "$jq_bin" -cS . 2>/dev/null); then
      journal_read_error=invalid-state
      return 2
    fi
    if [[ $output != "$canonical" ]]; then
      journal_read_error=invalid-state
      return 2
    fi
    if [[ $(printf '%s' "$output" | "$jq_bin" -r '.normalizedRequest | type') == object ]]; then
      if ! facts=$(printf '%s' "$output" | "$jq_bin" -cS '.normalizedRequest.facts' 2>/dev/null); then
        journal_read_error=invalid-state
        return 2
      fi
      computed_digest=$(printf '%s\n' "$facts" | native_run domain-hash \
        omarchy-plugin-transaction-request/v1 2>/dev/null || true)
      stored_digest=$(printf '%s' "$output" | "$jq_bin" -r '.normalizedRequest.digest')
      if [[ -z $computed_digest || $computed_digest != "$stored_digest" ]]; then
        journal_read_error=invalid-state
        return 2
      fi
    fi
    journal=$output
    journal_read_error=""
    return 0
  else
    read_status=$?
  fi
  if (( read_status == 3 )); then
    journal_read_error=operation-not-found
    return 1
  fi
  if (( read_status == 5 )); then
    journal_read_error=durability-indeterminate
    return 3
  fi
  journal_read_error=invalid-state
  return 2
}

read_journal() { read_journal_with_action journal-read; }
read_journal_authoritative() { read_journal_with_action journal-read-locked; }
read_journal_held() { read_journal_with_action journal-read-held; }

acquire_ordered_locks() {
  local ready status read_status
  coproc O8_LOCK_HOLDER {
    native_run ordered-lock "$state_root" "$request_operation_id" "$request_plugin_id"
  }
  lock_pid=$O8_LOCK_HOLDER_PID
  lock_read_fd=${O8_LOCK_HOLDER[0]}
  lock_write_fd=${O8_LOCK_HOLDER[1]}
  if IFS= read -r -t "$lock_timeout_seconds" ready <&"$lock_read_fd"; then
    :
  else
    read_status=$?
    if [[ -n $lock_pid ]]; then
      kill "$lock_pid" 2>/dev/null || true
    fi
    set +e
    wait "$lock_pid"
    status=$?
    set -e
    exec {lock_read_fd}<&-
    lock_read_fd=""
    lock_pid=""
    exec {lock_write_fd}>&-
    lock_write_fd=""
    locks_held=0
    (( status == 3 )) && return 3
    (( read_status == 142 )) && return 5
    return 4
  fi
  exec {lock_read_fd}<&-
  lock_read_fd=""
  [[ $ready == locked-operation-then-plugin ]] || return 4
  locks_held=1
}

release_ordered_locks() {
  if [[ -n $lock_write_fd ]]; then
    exec {lock_write_fd}>&-
    lock_write_fd=""
  fi
  if [[ -n $lock_pid ]]; then
    wait "$lock_pid" 2>/dev/null || true
    lock_pid=""
  fi
  locks_held=0
}

require_ordered_locks() {
  local response_state=${1:-}
  local status
  set +e
  acquire_ordered_locks
  status=$?
  set -e
  if (( status == 0 )); then
    return 0
  fi
  if (( status == 5 )); then
    emit_error indeterminate lock-timeout 5 "$response_state"
  fi
  emit_error unavailable lock-failure 4 "$response_state"
}

write_journal_transition() {
  local transition=$1 filter=$2 input
  input=$(/usr/bin/mktemp /tmp/omarchy-plugin-journal-transition.XXXXXX)
  if ! printf '%s' "$journal" | "$jq_bin" -cS "$filter" >"$input"; then
    /usr/bin/rm -f -- "$input"
    return 1
  fi
  chmod 0600 "$input"
  if ! "$jq_bin" -eS --arg operation_id "$request_operation_id" \
      -f "$journal_validator" "$input" >/dev/null 2>&1; then
    /usr/bin/rm -f -- "$input"
    return 1
  fi
  if ! native_run journal-replace "$state_root" "$request_operation_id" \
      "$input" "$transition" >/dev/null 2>&1; then
    /usr/bin/rm -f -- "$input"
    return 2
  fi
  /usr/bin/rm -f -- "$input"
  read_journal_held
}

operation_binding_for_journal() {
  printf '%s' "$journal" | "$jq_bin" -cS '
    {operationId,pluginId,
     operation: .normalizedRequest.facts.operation,
     requestDigest: .normalizedRequest.digest,
     candidateExpected: .candidate.expected,
     candidateObserved: .candidate.observed,
     candidateSlot: .candidate.completedSlot,
     expectedActive: .normalizedRequest.facts.expectedActive,
     destination: .normalizedRequest.facts.destination}' |
    native_run domain-hash omarchy-plugin-transaction-operation-binding/v1
}

# Reconstruct every commit fact from the authoritative journal.  O-8 replay
# is intentionally a fresh-process operation: no branch may depend on shell
# variables populated by an earlier invocation.
load_commit_context_from_journal() {
  local schema
  schema=$(printf '%s' "$journal" | "$jq_bin" -r '.schema // ""')
  operation_kind=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.operation // ""')
  request_plugin_id=$(printf '%s' "$journal" | "$jq_bin" -r '.pluginId // ""')
  destination=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.destination // ""')
  expected_candidate=$(printf '%s' "$journal" | "$jq_bin" -r '.candidate.observed // .candidate.expected // ""')
  candidate_path="$candidate_store/$request_operation_id/candidate"
  active_state=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedActive.state // ""')
  active_identity=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedActive.identity // ""')
  expected_config_kind=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedConfiguration.source.kind // ""')
  expected_config_identity=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedConfiguration.source.identity // ""')
  expected_projection=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedConfiguration.referenceProjection // ""')
  expected_reference_state=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedConfiguration.referenceState // ""')
  reference_policy=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedConfiguration.referencePolicy // ""')
  [[ -n $operation_kind && -n $request_plugin_id && -n $destination && -n $expected_candidate ]] || return 1
  [[ $schema == omarchy-plugin-transaction-journal/v1 || $schema == omarchy-plugin-transaction-journal/v2 ]] || return 1
  return 0
}

make_commit_prepared() {
  local binding input operation active_state active_identity destination
  binding=$(operation_binding_for_journal) || return 1
  operation=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.operation')
  destination=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.destination')
  active_state=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedActive.state')
  active_identity=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedActive.identity // ""')
  input=$(/usr/bin/mktemp /tmp/omarchy-plugin-journal-prepared.XXXXXX)
  printf '%s' "$journal" | "$jq_bin" -cS \
    --arg binding "$binding" --arg destination "$destination" --arg operation "$operation" \
    --arg activeState "$active_state" --arg activeIdentity "$active_identity" \
    '.schema="omarchy-plugin-transaction-journal/v2"
     | .operationBindingSha256=$binding
     | .candidate.role="candidate"
     | .publication={state:"completed-durable"}
     | .retainedPrior={state:"not-captured",identity:null,slot:null}
     | .namespaceIntent={kind:(if $operation=="install" then "install" else "exchange" end),state:"none",sourceSlot:.candidate.completedSlot,destination:$destination,candidate:.candidate.observed,prior:(if $activeState=="present" then $activeIdentity else null end)}
     | .rescan={outcome:"not-requested",shellInstance:null,generation:null,scanEpoch:null,sourceDirectory:null,expectedTree:null,observedTree:null}
     | .release={outcome:"not-requested",shellInstance:null,generation:null,configurationEpoch:null,source:null,rawSha256:null,referenceProjection:null,referenceState:null,referencePolicy:null}
     | .rollback="not-applicable"
     | .rollbackEvidence={state:"not-started",targetRole:"none",target:null,outcome:"not-applicable"}
     | .terminalReceipt={state:"not-requested",intendedJournalState:null,operationBindingSha256:null,operationId:null,pluginId:null,targetRole:"none",target:null,shellInstance:null,generation:null,scanEpoch:null,configurationEpoch:null,outcome:"not-requested"}
     | .gate="not-established" | .registry="not-requested" | .state="COMMIT_PREPARED" | .reason=null | .corruptEvidenceSha256=null' >"$input"
  chmod 0600 "$input"
  if ! "$jq_bin" -eS --arg operation_id "$request_operation_id" -f "$journal_validator" "$input" >/dev/null 2>&1; then
    /usr/bin/rm -f -- "$input"
    return 1
  fi
  if ! native_run journal-replace "$state_root" "$request_operation_id" "$input" staged-to-commit-prepared >/dev/null 2>&1; then
    /usr/bin/rm -f -- "$input"
    return 2
  fi
  /usr/bin/rm -f -- "$input"
  read_journal_held
}

emit_journal_response() {
  local response_action=$1 output
  if ! output=$(printf '%s' "$journal" | "$jq_bin" -cS --arg action "$response_action" '
    def public_tree($identity):
      if $identity == null or $identity == "" then null
      else {algorithm:"omarchy-runtime-tree-sha256-v1",
        digest:("sha256:" + ($identity | sub("^omarchy-runtime-tree-sha256-v1:"; "")))} end;
    def public_active($facts):
      if $facts == null then null
      elif (.state == "LIVE_TREE_EXCHANGED" or .state == "GATED_RESCAN_COMPLETED" or .state == "RELEASE_PENDING" or .state == "COMMITTED") then {state:"present",tree:public_tree(.candidate.observed)}
      elif .state == "ROLLED_BACK" and .retainedPrior.state == "absent" then {state:"absent"}
      elif .state == "ROLLED_BACK" and .retainedPrior.identity != null then {state:"present",tree:public_tree(.retainedPrior.identity)}
      elif .state == "ROLLBACK_STARTED" and .namespaceIntent.state == "completed" and .rollbackEvidence.targetRole == "absence" then {state:"absent"}
      elif .state == "ROLLBACK_STARTED" and .namespaceIntent.state == "completed" and .rollbackEvidence.target.identity != null then {state:"present",tree:public_tree(.rollbackEvidence.target.identity)}
      elif .state == "ROLLBACK_STARTED" and .namespaceIntent.state == "completed" then null
      elif .state == "RECOVERY_REQUIRED" or .state == "MANUAL_ATTENTION" then null
      elif .state == "ROLLBACK_STARTED" then {state:"present",tree:public_tree(.candidate.observed)}
      elif $facts.expectedActive.state == "absent" then {state:"absent"}
      else {state:"present",tree:public_tree($facts.expectedActive.identity)} end;
    def public_source($facts):
      if $facts == null then null
      elif $facts.stageObservation.provenance == "shell-authoritative-o7"
          and (($facts.expectedConfiguration.source.kind == "user"
                and $facts.expectedConfiguration.source.identity == "omarchy-shell-config:user:v1")
            or ($facts.expectedConfiguration.source.kind == "default"
                and ($facts.expectedConfiguration.source.identity == "omarchy-shell-config:packaged-default:v1"
                  or $facts.expectedConfiguration.source.identity == "omarchy-shell-config:builtin-default:v1")))
        then $facts.expectedConfiguration.source
      else {kind:$facts.expectedConfiguration.source.kind,identity:null} end;
    def public_configuration($facts):
      if $facts == null then null else {
        source:public_source($facts),
        rawSha256:$facts.stageObservation.rawSha256,
        referenceProjectionSha256:$facts.stageObservation.referenceProjection,
        referenceState:$facts.stageObservation.referenceState,
        referencePolicy:$facts.expectedConfiguration.referencePolicy
      } end;
    def public_after_configuration:
      if .release.source == null then null else {
        source:.release.source,
        rawSha256:.release.rawSha256,
        referenceProjectionSha256:.release.referenceProjection,
        referenceState:.release.referenceState,
        referencePolicy:.release.referencePolicy
      } end;
    def public_previous:
      if .retainedPrior == null or .retainedPrior.state == "not-captured" then null
      elif .retainedPrior.state == "absent" then {state:"absent"}
      elif .retainedPrior.identity != null then {state:"present",tree:public_tree(.retainedPrior.identity)}
      else null end;
    def public_registry:
      {state:(.registry // "not-requested"),rescan:(.rescan.outcome // "not-requested"),
       shellInstance:(.rescan.shellInstance // null),generation:(.rescan.generation // null),
       scanEpoch:(.rescan.scanEpoch // null)};
    def public_release:
      {outcome:(.release.outcome // "not-requested"),shellInstance:(.release.shellInstance // null),
       generation:(.release.generation // null),configurationEpoch:(.release.configurationEpoch // null)};
    def public_rollback:
      {state:(.rollback // "not-applicable"),evidenceState:(.rollbackEvidence.state // "not-started"),
       targetRole:(.rollbackEvidence.targetRole // "none"),outcome:(.rollbackEvidence.outcome // "not-applicable"),
       target:(if .rollbackEvidence.targetRole == "absence" then {state:"absent"}
               elif .rollbackEvidence.target.identity != null then {state:"present",tree:public_tree(.rollbackEvidence.target.identity)}
               else null end)};
    .normalizedRequest.facts as $facts
    | {protocol:"legacy-schema-v1-transaction/v1",action:$action,
       operationId,pluginId,state,
       status:(if .state == "STAGED" then "ok"
         elif .state == "COMMITTED" then "committed"
         elif .state == "ROLLED_BACK" then "rolled-back"
         elif .state == "REJECTED" then "rejected"
         elif .state == "ABORTED" then "aborted"
         elif .state == "RECOVERY_REQUIRED" then "indeterminate"
         elif .state == "MANUAL_ATTENTION" then "manual-attention"
         else "in-progress" end),
       reason:(if .state == "ABORTED" then "owner-aborted"
         elif .reason != null then .reason
         elif .state == "RECOVERY_REQUIRED" then "recovery-required"
         elif .state == "MANUAL_ATTENTION" then "manual-attention"
         elif .state == "REQUEST_BOUND" then "request-bound"
         elif .state == "PUBLICATION_INTENT" then "publication-intent"
         else null end),
       operation:($facts.operation // null),
       candidateTree:public_tree(.candidate.observed),
       previousTree:public_previous,
       observedActive:public_active($facts),
       filesystem:{live:public_active($facts),previous:public_previous},
       observedConfiguration:public_configuration($facts),
       configuration:{before:public_configuration($facts),after:(if .state == "COMMITTED" or .state == "ROLLED_BACK" then public_after_configuration else null end)},
       registry:public_registry,
       release:public_release,
       eligibility:(if .state == "COMMITTED" or .state == "ROLLED_BACK" then "released"
         elif .state == "STAGED" or .state == "ABORTED" or .state == "REJECTED" then "not-gated"
         elif .state == "RECOVERY_REQUIRED" or .state == "MANUAL_ATTENTION" then "indeterminate"
         else "blocked" end),
       rollback:public_rollback,
       recovery:{state:(if .state == "RECOVERY_REQUIRED" then "required" elif .state == "MANUAL_ATTENTION" then "manual-attention" else "none" end),reason:(if .state == "RECOVERY_REQUIRED" or .state == "MANUAL_ATTENTION" then .reason else null end)}}
  ' 2>/dev/null); then
    emit_error manual-attention invalid-state 4
  fi
  printf '%s\n' "$output"
}

stage_result_code=""
read_stage_result() {
  local line_count code
  [[ -n $stage_result_file && -f $stage_result_file && ! -L $stage_result_file ]] || return 1
  [[ $(stat -c '%h:%a:%s' "$stage_result_file" 2>/dev/null || true) =~ ^1:600:[0-9]+$ ]] || return 1
  line_count=$(wc -l <"$stage_result_file") || return 1
  [[ $line_count == 1 ]] || return 1
  IFS= read -r code <"$stage_result_file" || return 1
  [[ $code =~ ^[a-z][a-z0-9-]{0,63}$ ]] || return 1
  stage_result_code=$code
}

stage_failure() {
  local machine_code=${1:-invalid-helper-result} durable_state
  if [[ $machine_code == invalid-operation-token ]]; then
    emit_error rejected invalid-operation-token 3
  fi
  if read_journal_authoritative; then
    durable_state=$(printf '%s' "$journal" | "$jq_bin" -r '.state')
    if [[ $machine_code == operation-conflict ]]; then
      emit_error rejected operation-id-conflict 3 "$durable_state"
    fi
    emit_journal_response stage
    case $durable_state in
      RECOVERY_REQUIRED) exit 5 ;;
      MANUAL_ATTENTION) exit 4 ;;
      *) exit 0 ;;
    esac
  fi
  if [[ $journal_read_error == durability-indeterminate ]]; then
    emit_error indeterminate journal-authority-indeterminate 5
  fi
  if [[ $journal_read_error != operation-not-found ]]; then
    emit_error manual-attention invalid-state 4
  fi
  case $machine_code in
    invalid-operation-token) emit_error rejected invalid-operation-token 3 ;;
    operation-conflict) emit_error rejected operation-id-conflict 3 ;;
    stale-candidate) emit_error rejected stale-candidate 0 ;;
    validation-failed|manifest-id-mismatch|invalid-manifest-id)
      emit_error rejected invalid-candidate 0 ;;
    invalid-source|invalid-destination|invalid-store|invalid-state-root|invalid-discovery-directory)
      emit_error rejected invalid-source 0 ;;
    recovery-required|journal-indeterminate|journal-io|journal-evidence-io)
      emit_error indeterminate durable-outcome-indeterminate 5 RECOVERY_REQUIRED ;;
    manual-attention) emit_error manual-attention manual-attention 4 MANUAL_ATTENTION ;;
    *) emit_error unavailable local-io-failure 4 ;;
  esac
}

invoke_stage_candidate() {
  local -a stage_environment
  stage_environment=(/usr/bin/env -i "HOME=$HOME" "PATH=$PATH" "LC_ALL=C"
    "OMARCHY_PATH=$package_root"
    "OMARCHY_PLUGIN_TREE_HELPER=$native_helper"
    "OMARCHY_PLUGIN_VALIDATOR=$package_root/bin/omarchy-plugin-validate"
    "OMARCHY_PLUGIN_JOURNAL_VALIDATOR=$journal_validator"
    "OMARCHY_PLUGIN_CANDIDATE_STORE=$candidate_store"
    "OMARCHY_PLUGIN_TRANSACTION_STATE=$state_root"
    "OMARCHY_PLUGIN_DISCOVERY_DIR=$discovery_dir"
    "OMARCHY_PLUGIN_OPERATION_KIND=$operation_kind"
    "OMARCHY_PLUGIN_SOURCE_KIND=directory"
    "OMARCHY_PLUGIN_CALLER_CANDIDATE_IDENTITY=$candidate_identity"
    "OMARCHY_PLUGIN_EXPECTED_ACTIVE_STATE=$active_state"
    "OMARCHY_PLUGIN_EXPECTED_ACTIVE_IDENTITY=$active_identity"
    "OMARCHY_PLUGIN_EXPECTED_CONFIG_SOURCE_KIND=$expected_config_kind"
    "OMARCHY_PLUGIN_EXPECTED_CONFIG_SOURCE_IDENTITY=$expected_config_identity"
    "OMARCHY_PLUGIN_EXPECTED_REFERENCE_PROJECTION=$expected_projection"
    "OMARCHY_PLUGIN_EXPECTED_REFERENCE_STATE=$expected_reference_state"
    "OMARCHY_PLUGIN_REFERENCE_POLICY=$reference_policy"
    "OMARCHY_PLUGIN_STAGE_OBSERVATION_SOURCE=$observation_source"
    "OMARCHY_PLUGIN_STAGE_OBSERVATION_RAW_SHA256=$observed_raw"
    "OMARCHY_PLUGIN_STAGE_OBSERVATION_REFERENCE_PROJECTION=$observed_projection"
    "OMARCHY_PLUGIN_STAGE_OBSERVATION_REFERENCE_STATE=$observed_reference_state"
    "OMARCHY_PLUGIN_DESTINATION=$destination")
  [[ -z ${XDG_STATE_HOME:-} ]] || stage_environment+=("XDG_STATE_HOME=$XDG_STATE_HOME")
  [[ -z $stage_result_read_fd ]] || exec {stage_result_read_fd}<&- || true
  [[ -z $stage_result_write_fd ]] || exec {stage_result_write_fd}>&- || true
  [[ -z $stage_result_file ]] || /usr/bin/rm -f -- "$stage_result_file"
  [[ -z $stage_stdout_file ]] || /usr/bin/rm -f -- "$stage_stdout_file"
  [[ -z $stage_stderr_file ]] || /usr/bin/rm -f -- "$stage_stderr_file"
  stage_result_read_fd=""
  stage_result_write_fd=""
  stage_result_file=""
  stage_stdout_file=""
  stage_stderr_file=""
  stage_result_file=$(/usr/bin/mktemp /tmp/omarchy-plugin-stage-result.XXXXXX)
  stage_stdout_file=$(/usr/bin/mktemp /tmp/omarchy-plugin-stage-stdout.XXXXXX)
  stage_stderr_file=$(/usr/bin/mktemp /tmp/omarchy-plugin-stage-stderr.XXXXXX)
  chmod 0600 "$stage_result_file" "$stage_stdout_file" "$stage_stderr_file"
  exec {stage_result_read_fd}<"$stage_result_file"
  exec {stage_result_write_fd}>"$stage_result_file"
  local stage_status
  set +e
  printf '%s\n' "$operation_token" |
    "${stage_environment[@]}" "$stage_helper" "$request_operation_id" \
      "$request_plugin_id" "$source_path" 3>&"$stage_result_write_fd" \
      >"$stage_stdout_file" 2>"$stage_stderr_file"
  stage_status=$?
  set -e
  exec {stage_result_write_fd}>&-
  if [[ -s $stage_stderr_file ]]; then
    /usr/bin/cat -- "$stage_stderr_file" >&2
  fi
  unset operation_token
  if ! read_stage_result; then
    stage_failure invalid-helper-result
  fi
  if (( stage_status != 0 )); then
    stage_failure "$stage_result_code"
  fi
  [[ $stage_result_code == success ]] || stage_failure "$stage_result_code"
  return 0
}

shell_call() {
  local method=$1
  shift
  local -a environment
  environment=(/usr/bin/env -i "HOME=$HOME" "PATH=$PATH" "LC_ALL=C"
    "OMARCHY_PATH=$package_root" "OMARCHY_SHELL_IPC_TIMEOUT=5")
  for environment_name in XDG_CONFIG_HOME XDG_CACHE_HOME XDG_STATE_HOME XDG_RUNTIME_DIR WAYLAND_DISPLAY; do
    [[ -z ${!environment_name:-} ]] || environment+=("$environment_name=${!environment_name}")
  done
  "${environment[@]}" "$shell_client" shell "$method" "$@"
}

wait_shell_transaction_status() {
  local expected_status=$1 output status deadline=$((SECONDS + lock_timeout_seconds))
  # The shell result map is the action completion channel; the durable gate
  # and journal readers below remain the transaction authority.  A bounded
  # result wait prevents a coordinator from treating a helper pathname as an
  # acknowledgement and forces timeout reconciliation at the caller.
  while (( SECONDS < deadline )); do
    if ! output=$(shell_call transactionPluginState "$request_operation_id" 2>/dev/null); then
      # Older/unit shells may not expose the optional result query.  The
      # caller still performs authoritative durable gate reconciliation; do
      # not spend the whole wait budget on an unavailable query seam.
      return 2
    fi
    if status=$(printf '%s' "$output" | "$jq_bin" -r --arg op "$request_operation_id" \
        '. as $result | select(type == "object" and .operationId == $op) | .status' 2>/dev/null) &&
       [[ -n $status && $status != null && $status == "$expected_status" ]]; then
      return 0
    fi
    (( SECONDS >= deadline )) && break
    /usr/bin/sleep 0.1
  done
  return 1
}

reconcile_terminal_shell() {
  local response
  response=$(shell_call transactionTerminalReconcile "$request_operation_id" "$request_plugin_id" 2>/dev/null) || return 1
  [[ $response == pending || $response == ok ]] || return 1
  wait_shell_transaction_status terminal-pair-reconciled
}

commit_validate_authority() {
  local -a environment output_env
  local output observed_kind observed_identity observed_state observed_source observed_raw_base64 observed_projection_base64
  local observed_raw_hash observed_projection_hash observed_discovery observed_state_root active_observed active_source manifest_id
  environment=(/usr/bin/env -i "HOME=$HOME" "PATH=$PATH" "LC_ALL=C"
    "OMARCHY_PATH=$package_root" "OMARCHY_SHELL_IPC_TIMEOUT=5")
  for environment_name in XDG_CONFIG_HOME XDG_CACHE_HOME XDG_STATE_HOME XDG_RUNTIME_DIR WAYLAND_DISPLAY; do
    [[ -z ${!environment_name:-} ]] || environment+=("$environment_name=${!environment_name}")
  done
  authority_reason=""
  if ! output=$("${environment[@]}" "$shell_client" shell transactionStageObservation "$request_plugin_id" 2>/dev/null); then
    authority_reason=shell-authority-unavailable
    return 1
  fi
  if ! output=$(printf '%s' "$output" | native_run json-request-check 2>/dev/null); then
    authority_reason=invalid-shell-observation
    return 1
  fi
  if ! printf '%s' "$output" | "$jq_bin" -e --arg plugin_id "$request_plugin_id" -f "$observation_validator" >/dev/null 2>&1; then
    authority_reason=invalid-shell-observation
    return 1
  fi
  [[ $(printf '%s' "$output" | "$jq_bin" -r '.valid') == true ]] || {
    authority_reason=shell-authority-unavailable
    return 1
  }
  observed_kind=$(printf '%s' "$output" | "$jq_bin" -r '.configurationSource.kind')
  observed_identity=$(printf '%s' "$output" | "$jq_bin" -r '.configurationSource.identity')
  observed_state=$(printf '%s' "$output" | "$jq_bin" -r '.referenceState')
  observed_raw_base64=$(printf '%s' "$output" | "$jq_bin" -r '.rawBase64')
  observed_projection_base64=$(printf '%s' "$output" | "$jq_bin" -r '.referenceProjectionBase64')
  observed_discovery=$(printf '%s' "$output" | "$jq_bin" -r '.discoveryDirectory')
  observed_state_root=$(printf '%s' "$output" | "$jq_bin" -r '.transactionStateRoot')
  observed_raw_hash=sha256:$(printf '%s' "$observed_raw_base64" | "$base64_bin" -d | "$sha256_bin" | /usr/bin/cut -d' ' -f1)
  observed_projection_hash=sha256:$(printf '%s' "$observed_projection_base64" | "$base64_bin" -d | "$sha256_bin" | /usr/bin/cut -d' ' -f1)
  authority_observed_kind=$observed_kind
  authority_observed_identity=$observed_identity
  authority_observed_raw_hash=$observed_raw_hash
  authority_observed_projection_hash=$observed_projection_hash
  authority_observed_reference_state=$observed_state
  authority_observed_epoch=$(printf '%s' "$output" | "$jq_bin" -r '.configurationEpoch // -1')
  [[ $observed_kind == "$expected_config_kind" && $observed_identity == "$expected_config_identity" ]] || {
    authority_reason=stale-configuration-source
    return 2
  }
  [[ $observed_projection_hash == "$expected_projection" ]] || {
    authority_reason=stale-reference-projection
    return 2
  }
  [[ $observed_state == "$expected_reference_state" ]] || {
    if [[ $reference_policy == require-unreferenced ]]; then authority_reason=require-unreferenced-violation
    else authority_reason=stale-reference-state
    fi
    return 2
  }
  [[ $observed_discovery == "$discovery_dir" && $observed_state_root == "$state_root" ]] || {
    authority_reason=invalid-shell-observation
    return 1
  }
  active_observed=$(printf '%s' "$output" | "$jq_bin" -r '.activeDiscovery.state')
  if [[ $authority_phase == post ]]; then
    [[ $active_observed == present ]] || { authority_reason=stale-active-tree; return 2; }
    observed_source=$(printf '%s' "$output" | "$jq_bin" -r '.activeDiscovery.sourceDirectory')
    [[ $observed_source == "$destination" ]] || { authority_reason=registry-source-ambiguous; return 2; }
    [[ $(native_run identity "$destination" 2>/dev/null || true) == "${expected_candidate:-}" ]] || { authority_reason=stale-active-tree; return 2; }
  elif [[ $authority_phase == rollback ]]; then
    if [[ ${rollback_target_role:-} == absence ]]; then
      [[ $active_observed == absent && ! -e "$destination" && ! -L "$destination" ]] || {
        authority_reason=stale-active-tree
        return 2
      }
    else
      [[ $active_observed == present ]] || { authority_reason=stale-active-tree; return 2; }
      observed_source=$(printf '%s' "$output" | "$jq_bin" -r '.activeDiscovery.sourceDirectory')
      [[ $observed_source == "$destination" ]] || { authority_reason=registry-source-ambiguous; return 2; }
      [[ $(native_run identity "$destination" 2>/dev/null || true) == "${rollback_target_identity:-}" ]] || {
        authority_reason=stale-active-tree
        return 2
      }
    fi
  elif [[ $operation_kind == install ]]; then
    [[ $active_observed == absent && ! -e "$destination" && ! -L "$destination" ]] || {
      authority_reason=stale-active-tree
      return 2
    }
  else
    [[ $active_observed == present ]] || { authority_reason=stale-active-tree; return 2; }
    observed_source=$(printf '%s' "$output" | "$jq_bin" -r '.activeDiscovery.sourceDirectory')
    [[ $observed_source == "$destination" ]] || { authority_reason=registry-source-ambiguous; return 2; }
    [[ -f "$destination/manifest.json" && ! -L "$destination/manifest.json" ]] || { authority_reason=registry-source-ambiguous; return 2; }
    manifest_id=$("$jq_bin" -er '.id | select(type == "string")' "$destination/manifest.json" 2>/dev/null || true)
    [[ $manifest_id == "$request_plugin_id" ]] || { authority_reason=registry-source-ambiguous; return 2; }
    [[ $(native_run identity "$destination" 2>/dev/null || true) == "$active_identity" ]] || { authority_reason=stale-active-tree; return 2; }
  fi
  return 0
}

read_gate_state() {
  local plugin=$1 output
  if (( locks_held == 1 )); then
    output=$(native_run gate-read-held "$state_root" "$plugin" 2>/dev/null) || return $?
  else
    output=$(native_run gate-read-locked "$state_root" "$request_operation_id" "$plugin" 2>/dev/null) || return $?
  fi
  printf '%s' "$output" | "$jq_bin" -eS --arg plugin_id "$plugin" -f "$gate_validator" >/dev/null 2>&1 || return 2
  gate_record=$output
  printf '%s' "$output" | "$jq_bin" -r '.state'
}

wait_gate_state() {
  local expected=$1 state="" deadline=$((SECONDS + lock_timeout_seconds))
  # Gate visibility is only a progress hint.  Each probe is an authoritative
  # locked read, and the whole wait has one package-owned bound rather than a
  # fixed retry count which could multiply a lock-reader timeout.
  while (( SECONDS < deadline )); do
    state=$(read_gate_state "$request_plugin_id" 2>/dev/null || true)
    if [[ $state == "$expected" ]]; then
      return 0
    fi
    (( SECONDS >= deadline )) && break
    /usr/bin/sleep 0.1
  done
  return 1
}

commit_result_from_journal() {
  local state=$1
  case $state in
    COMMITTED|ROLLED_BACK|REJECTED|ABORTED|STAGED)
      emit_journal_response commit
      exit 0
      ;;
    RECOVERY_REQUIRED) emit_error indeterminate recovery-required 5 "$state" ;;
    MANUAL_ATTENTION) emit_error manual-attention manual-attention 4 "$state" ;;
    *) emit_journal_response commit; exit 0 ;;
  esac
}

reject_prepared() {
  local reason=$1 lock_status gate_status gate_state
  # A stale COMMIT_PREPARED observation can be detected before the normal
  # commit lock acquisition.  Serialize the terminalization itself, while
  # remaining compatible with callers that already hold both locks.
  if (( locks_held == 0 )); then
    set +e
    acquire_ordered_locks
    lock_status=$?
    set -e
    if (( lock_status != 0 )); then
      (( lock_status == 5 )) && emit_error indeterminate lock-timeout 5 COMMIT_PREPARED
      emit_error unavailable lock-failure 4 COMMIT_PREPARED
    fi
    if ! read_journal_held; then
      release_ordered_locks
      emit_error indeterminate journal-authority-indeterminate 5 COMMIT_PREPARED
    fi
  fi
  [[ $(printf '%s' "$journal" | "$jq_bin" -r '.state') == COMMIT_PREPARED ]] || {
    release_ordered_locks
    commit_result_from_journal "$(printf '%s' "$journal" | "$jq_bin" -r '.state')"
  }
  # A gate is durable authority.  Its absence is established by the locked,
  # synchronized reader; pathname absence alone is not sufficient evidence.
  if read_gate_state "$request_plugin_id" >/dev/null 2>&1; then
    gate_state=${gate_record:-}
    [[ -n $gate_state ]] || {
      mark_recovery pre-exposure-gate-indeterminate COMMIT_PREPARED
    }
    mark_recovery "pre-exposure-$reason" COMMIT_PREPARED
  else
    gate_status=$?
    (( gate_status == 3 )) || mark_recovery pre-exposure-gate-indeterminate COMMIT_PREPARED
  fi
  if ! write_journal_transition commit-prepared-to-rejected \
      ".state=\"REJECTED\" | .reason=\"$reason\" | .gate=\"not-established\" | .namespaceIntent.state=\"none\" | .rollback=\"not-applicable\""; then
    release_ordered_locks
    emit_error indeterminate journal-indeterminate 5 COMMIT_PREPARED
  fi
  release_ordered_locks
  read_journal_authoritative || emit_error indeterminate journal-authority-indeterminate 5 REJECTED
  emit_journal_response commit
  exit 0
}

reject_staged() {
  local reason=$1 lock_status
  set +e
  acquire_ordered_locks
  lock_status=$?
  set -e
  (( lock_status == 0 )) || {
    [[ $lock_status == 5 ]] && emit_error indeterminate lock-timeout 5 STAGED
    emit_error unavailable lock-failure 4 STAGED
  }
  if ! read_journal_held || [[ $(printf '%s' "$journal" | "$jq_bin" -r '.state') != STAGED ]]; then
    release_ordered_locks
    emit_error indeterminate journal-authority-indeterminate 5 STAGED
  fi
  # Convert the legacy STAGED record to a complete v2 record before writing a
  # typed rejection.  The v1 validator intentionally has no REJECTED state.
  if ! make_commit_prepared; then
    release_ordered_locks
    emit_error indeterminate journal-indeterminate 5 STAGED
  fi
  if ! write_journal_transition staged-to-rejected \
      ".state=\"REJECTED\" | .reason=\"$reason\" | .gate=\"not-established\" | .namespaceIntent.state=\"none\" | .rollback=\"not-applicable\""; then
    release_ordered_locks
    emit_error indeterminate journal-indeterminate 5 STAGED
  fi
  release_ordered_locks
  read_journal_authoritative || emit_error indeterminate journal-authority-indeterminate 5 REJECTED
  emit_journal_response commit
  exit 0
}

mark_recovery() {
  local reason=$1 response_state=${2:-RECOVERY_REQUIRED}
  if ! write_journal_transition o8-to-recovery ".state=\"RECOVERY_REQUIRED\" | .reason=\"$reason\" | .gate=\"established\""; then
    release_ordered_locks
    emit_error indeterminate journal-indeterminate 5 "$response_state"
  fi
  release_ordered_locks
  emit_error indeterminate "$reason" 5 RECOVERY_REQUIRED
}

# Direct rollback is deliberately narrow: it is entered only after a durable
# gate and a live-tree exchange exist, and it never deletes the retained
# candidate/prior slot.
rollback_operation() {
  local rollback_reason=$1 state operation destination expected_candidate prior_identity
  local target_role target_identity source_parent source_name dest_parent dest_name
  local mutation_result mutation_status mutation_outcome rollback_input
  local namespace_state rollback_rescan_outcome terminal_gate_state
  local rollback_release_input
  local terminal_shell terminal_generation terminal_configuration_epoch
  if ! acquire_ordered_locks || ! read_journal_held; then
    release_ordered_locks
    emit_error indeterminate rollback-authority-indeterminate 5 ROLLBACK_STARTED
  fi
  state=$(printf '%s' "$journal" | "$jq_bin" -r '.state')
  operation=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.operation')
  destination=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.destination')
  expected_candidate=$(printf '%s' "$journal" | "$jq_bin" -r '.candidate.observed')
  prior_identity=$(printf '%s' "$journal" | "$jq_bin" -r '.retainedPrior.identity // ""')
  expected_config_kind=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedConfiguration.source.kind')
  expected_config_identity=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedConfiguration.source.identity')
  expected_projection=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedConfiguration.referenceProjection')
  expected_reference_state=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedConfiguration.referenceState')
  reference_policy=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedConfiguration.referencePolicy')
  # Only ROLLBACK_STARTED carries rollback-specific namespace/rescan evidence;
  # LIVE_TREE_EXCHANGED's completed forward intent must never suppress the
  # first reverse mutation.
  namespace_state=$(printf '%s' "$journal" | "$jq_bin" -r 'if .state == "ROLLBACK_STARTED" then (.namespaceIntent.state // "none") else "none" end')
  rollback_rescan_outcome=$(printf '%s' "$journal" | "$jq_bin" -r 'if .state == "ROLLBACK_STARTED" then (.rescan.outcome // "not-requested") else "not-requested" end')
  case $operation in
    install) target_role=absence; target_identity="" ;;
    update)
      target_role=prior-tree; target_identity=$prior_identity
      [[ $target_identity =~ ^omarchy-runtime-tree-sha256-v1:[0-9a-f]{64}$ ]] ||
        { release_ordered_locks; emit_error manual-attention retained-prior-missing 4 ROLLBACK_STARTED; }
      ;;
    *) release_ordered_locks; emit_error manual-attention invalid-operation-kind 4 ROLLBACK_STARTED ;;
  esac
  case $state in
    LIVE_TREE_EXCHANGED|GATED_RESCAN_COMPLETED|RELEASE_PENDING|ROLLBACK_STARTED|RELEASE_AUTHORIZED) ;;
    COMMITTED|ROLLED_BACK|REJECTED|ABORTED)
      release_ordered_locks
      commit_result_from_journal "$state"
      ;;
    *) release_ordered_locks; emit_error indeterminate rollback-state-not-rollbackable 5 "$state" ;;
  esac
  if [[ $state != ROLLBACK_STARTED ]]; then
    rollback_input=$(/usr/bin/mktemp /tmp/omarchy-plugin-journal-rollback.XXXXXX)
    if [[ $target_role == absence ]]; then
      printf '%s' "$journal" | "$jq_bin" -cS --arg reason "$rollback_reason" --arg role "$target_role" \
        '.state="ROLLBACK_STARTED" | .reason=$reason | .gate="established" | .rollback="pending" | .rollbackEvidence={state:"intended",targetRole:$role,target:{state:"absent",identity:null},outcome:"pending"} | .namespaceIntent={kind:"rollback-install",state:"intended",sourceSlot:"live",destination:.normalizedRequest.facts.destination,candidate:.candidate.observed,prior:null} | .rescan={outcome:"not-requested",shellInstance:null,generation:null,scanEpoch:null,sourceDirectory:null,expectedTree:null,observedTree:null} | .release={outcome:"not-requested",shellInstance:null,generation:null,configurationEpoch:null,source:null,rawSha256:null,referenceProjection:null,referenceState:null,referencePolicy:null} | .terminalReceipt={state:"not-requested",intendedJournalState:null,operationBindingSha256:null,operationId:null,pluginId:null,targetRole:"none",target:null,shellInstance:null,generation:null,scanEpoch:null,configurationEpoch:null,outcome:"not-requested"}' >"$rollback_input"
    else
      printf '%s' "$journal" | "$jq_bin" -cS --arg reason "$rollback_reason" --arg role "$target_role" --arg identity "$target_identity" \
        '.state="ROLLBACK_STARTED" | .reason=$reason | .gate="established" | .rollback="pending" | .rollbackEvidence={state:"intended",targetRole:$role,target:{state:"present",identity:$identity},outcome:"pending"} | .namespaceIntent={kind:"rollback-exchange",state:"intended",sourceSlot:.candidate.completedSlot,destination:.normalizedRequest.facts.destination,candidate:.candidate.observed,prior:$identity} | .rescan={outcome:"not-requested",shellInstance:null,generation:null,scanEpoch:null,sourceDirectory:null,expectedTree:null,observedTree:null} | .release={outcome:"not-requested",shellInstance:null,generation:null,configurationEpoch:null,source:null,rawSha256:null,referenceProjection:null,referenceState:null,referencePolicy:null} | .terminalReceipt={state:"not-requested",intendedJournalState:null,operationBindingSha256:null,operationId:null,pluginId:null,targetRole:"none",target:null,shellInstance:null,generation:null,scanEpoch:null,configurationEpoch:null,outcome:"not-requested"}' >"$rollback_input"
    fi
    chmod 0600 "$rollback_input"
    if ! "$jq_bin" -eS --arg operation_id "$request_operation_id" -f "$journal_validator" "$rollback_input" >/dev/null 2>&1 ||
       ! native_run journal-replace "$state_root" "$request_operation_id" "$rollback_input" o8-rollback-started >/dev/null 2>&1; then
      /usr/bin/rm -f -- "$rollback_input"
      release_ordered_locks
      emit_error indeterminate rollback-journal-indeterminate 5 ROLLBACK_STARTED
    fi
    /usr/bin/rm -f -- "$rollback_input"
    read_journal_held || { release_ordered_locks; emit_error indeterminate rollback-journal-indeterminate 5 ROLLBACK_STARTED; }
  fi
  release_ordered_locks
  if [[ $rollback_rescan_outcome != completed ]]; then
    current_gate=$(read_gate_state "$request_plugin_id" 2>/dev/null || true)
    if [[ $current_gate == RELEASE_AUTHORIZED ]]; then
      shell_call retainTransactionPlugin "$request_operation_id" "$request_plugin_id" >/dev/null 2>&1 ||
        emit_error indeterminate release-acknowledgement-indeterminate 5 ROLLBACK_STARTED
      wait_gate_state UNLOAD_ACKNOWLEDGED ||
        emit_error indeterminate release-acknowledgement-indeterminate 5 ROLLBACK_STARTED
    elif [[ $current_gate != UNLOAD_ACKNOWLEDGED && $current_gate != RESCAN_ACKNOWLEDGED ]]; then
      emit_error indeterminate rollback-gate-authority-indeterminate 5 ROLLBACK_STARTED
    fi
    shell_call rollbackTransactionPlugin "$request_operation_id" "$request_plugin_id" "$target_role" "$target_identity" >/dev/null 2>&1 ||
      emit_error indeterminate rollback-gate-authority-indeterminate 5 ROLLBACK_STARTED
    wait_shell_transaction_status rollback-targeted || true
    wait_gate_state UNLOAD_ACKNOWLEDGED ||
      emit_error indeterminate rollback-gate-authority-indeterminate 5 ROLLBACK_STARTED
  fi
  if ! acquire_ordered_locks || ! read_journal_held; then
    release_ordered_locks
    emit_error indeterminate rollback-authority-indeterminate 5 ROLLBACK_STARTED
  fi
  [[ $(printf '%s' "$journal" | "$jq_bin" -r '.state') == ROLLBACK_STARTED ]] ||
    { release_ordered_locks; emit_error indeterminate rollback-state-changed 5 ROLLBACK_STARTED; }
  gate_path=$state_root/gates/$request_plugin_id.gate
  current_gate=$(read_gate_state "$request_plugin_id" 2>/dev/null || true)
  if [[ $rollback_rescan_outcome == completed ]]; then
    [[ -f $gate_path && $current_gate == RESCAN_ACKNOWLEDGED ]] ||
      { release_ordered_locks; emit_error indeterminate rollback-gate-mismatch 5 ROLLBACK_STARTED; }
  else
    [[ -f $gate_path && $current_gate == UNLOAD_ACKNOWLEDGED ]] ||
      { release_ordered_locks; emit_error indeterminate rollback-gate-mismatch 5 ROLLBACK_STARTED; }
  fi
  # A fresh-process retry resumes from durable rollback evidence.  Once the
  # reverse namespace operation is recorded complete, never invoke the native
  # rename/exchange a second time.
  if [[ $namespace_state != completed ]]; then
  dest_parent=$(/usr/bin/dirname -- "$destination")
  dest_name=$(/usr/bin/basename -- "$destination")
  if [[ $operation == install ]]; then
    source_parent=$discovery_dir
    source_name=$request_plugin_id
    dest_parent=$candidate_store/$request_operation_id
    dest_name=candidate
    mutation_result=$(native_run namespace-mutate rollback-install "$source_parent" "$source_name" "$dest_parent" "$dest_name" "$expected_candidate" "" 2>/dev/null) || mutation_status=$?
  else
    source_parent=$candidate_store/$request_operation_id
    source_name=candidate
    mutation_result=$(native_run namespace-mutate rollback-exchange "$source_parent" "$source_name" "$dest_parent" "$dest_name" "$prior_identity" "$expected_candidate" 2>/dev/null) || mutation_status=$?
  fi
  mutation_status=${mutation_status:-0}
  mutation_outcome=$(printf '%s' "$mutation_result" | "$jq_bin" -r '.status // "invalid-result"' 2>/dev/null || printf '%s' invalid-result)
  if (( mutation_status != 0 )) || [[ $mutation_outcome != completed-durable ]]; then
    release_ordered_locks
    emit_error indeterminate "rollback-${mutation_outcome}" 5 ROLLBACK_STARTED
  fi
  rollback_input=$(/usr/bin/mktemp /tmp/omarchy-plugin-journal-rollback-complete.XXXXXX)
  printf '%s' "$journal" | "$jq_bin" -cS --arg role "$target_role" --arg identity "$target_identity" \
    '.namespaceIntent.state="completed" | .namespaceIntent.kind=(if .normalizedRequest.facts.operation=="install" then "rollback-install" else "rollback-exchange" end) | .rollbackEvidence={state:"completed",targetRole:$role,target:(if $role=="absence" then {state:"absent",identity:null} else {state:"present",identity:$identity} end),outcome:"restored"} | .retainedPrior=(if .normalizedRequest.facts.operation=="install" then {state:"absent",identity:null,slot:null} else .retainedPrior + {state:"restored"} end)' >"$rollback_input"
  chmod 0600 "$rollback_input"
  if ! "$jq_bin" -eS --arg operation_id "$request_operation_id" -f "$journal_validator" "$rollback_input" >/dev/null 2>&1 ||
     ! native_run journal-replace "$state_root" "$request_operation_id" "$rollback_input" rollback-namespace-complete >/dev/null 2>&1; then
    /usr/bin/rm -f -- "$rollback_input"
    release_ordered_locks
    emit_error indeterminate rollback-journal-indeterminate 5 ROLLBACK_STARTED
  fi
  /usr/bin/rm -f -- "$rollback_input"
  read_journal_held || { release_ordered_locks; emit_error indeterminate rollback-journal-indeterminate 5 ROLLBACK_STARTED; }
  fi
  release_ordered_locks
  if [[ $rollback_rescan_outcome != completed ]]; then
    shell_call rescanRollbackPlugin "$request_operation_id" "$request_plugin_id" >/dev/null 2>&1 ||
      emit_error indeterminate rollback-rescan-indeterminate 5 ROLLBACK_STARTED
    wait_shell_transaction_status rollback-rescan-complete || true
    wait_gate_state RESCAN_ACKNOWLEDGED ||
      emit_error indeterminate rollback-rescan-indeterminate 5 ROLLBACK_STARTED
  fi
  if ! acquire_ordered_locks || ! read_journal_held; then
    release_ordered_locks
    emit_error indeterminate rollback-authority-indeterminate 5 ROLLBACK_STARTED
  fi
  if [[ $rollback_rescan_outcome != completed ]]; then
    gate_path=$state_root/gates/$request_plugin_id.gate
    rollback_shell=$("$jq_bin" -r '.rescan.shellInstance' "$gate_path")
    rollback_generation=$("$jq_bin" -r '.rescan.generation' "$gate_path")
    rollback_epoch=$("$jq_bin" -r '.rescan.scanEpoch' "$gate_path")
    rollback_source=$("$jq_bin" -r '.rescan.sourceDirectory' "$gate_path")
    rollback_input=$(/usr/bin/mktemp /tmp/omarchy-plugin-journal-rollback-rescan.XXXXXX)
    if [[ $target_role == absence ]]; then
    printf '%s' "$journal" | "$jq_bin" -cS --arg shell "$rollback_shell" --argjson generation "$rollback_generation" --argjson scanEpoch "$rollback_epoch" --arg source "$rollback_source" \
      '.registry="completed" | .rescan={outcome:"completed",shellInstance:$shell,generation:$generation,scanEpoch:$scanEpoch,sourceDirectory:$source,expectedTree:null,observedTree:null}' >"$rollback_input"
  else
    printf '%s' "$journal" | "$jq_bin" -cS --arg shell "$rollback_shell" --argjson generation "$rollback_generation" --argjson scanEpoch "$rollback_epoch" --arg source "$rollback_source" --arg tree "$target_identity" \
      '.registry="completed" | .rescan={outcome:"completed",shellInstance:$shell,generation:$generation,scanEpoch:$scanEpoch,sourceDirectory:$source,expectedTree:$tree,observedTree:$tree}' >"$rollback_input"
    fi
    chmod 0600 "$rollback_input"
    if ! "$jq_bin" -eS --arg operation_id "$request_operation_id" -f "$journal_validator" "$rollback_input" >/dev/null 2>&1 ||
       ! native_run journal-replace "$state_root" "$request_operation_id" "$rollback_input" rollback-rescan-complete >/dev/null 2>&1; then
      /usr/bin/rm -f -- "$rollback_input"
      release_ordered_locks
      emit_error indeterminate rollback-journal-indeterminate 5 ROLLBACK_STARTED
    fi
    /usr/bin/rm -f -- "$rollback_input"
    read_journal_held || { release_ordered_locks; emit_error indeterminate rollback-journal-indeterminate 5 ROLLBACK_STARTED; }
  fi
  release_ordered_locks
  # Capture the actual rollback-release configuration/reference authority from
  # the same O-6 producer used by loaders and candidate release.  This is
  # evidence, not a caller-supplied copy of the stage observation, and is
  # deliberately taken after the rollback rescan boundary.
  terminal_gate_state=$(read_gate_state "$request_plugin_id" 2>/dev/null || true)
  if [[ $terminal_gate_state != TERMINAL_RECEIPT ]]; then
    rollback_target_role=$target_role
    rollback_target_identity=$target_identity
    authority_phase=rollback
    set +e
    commit_validate_authority
    authority_status=$?
    set -e
    if (( authority_status != 0 )); then
      emit_error indeterminate "rollback-release-precondition-${authority_reason:-indeterminate}" 5 ROLLBACK_STARTED
    fi
    rollback_release_input=$(/usr/bin/mktemp /tmp/omarchy-plugin-journal-rollback-authority.XXXXXX)
    printf '%s' "$journal" | "$jq_bin" -cS --arg kind "$authority_observed_kind" --arg identity "$authority_observed_identity" --arg raw "$authority_observed_raw_hash" --arg projection "$authority_observed_projection_hash" --arg referenceState "$authority_observed_reference_state" --arg policy "$reference_policy" --argjson epoch "$authority_observed_epoch" \
      '.release={outcome:"not-requested",shellInstance:null,generation:null,configurationEpoch:$epoch,source:{kind:$kind,identity:$identity},rawSha256:$raw,referenceProjection:$projection,referenceState:$referenceState,referencePolicy:$policy}' >"$rollback_release_input"
    chmod 0600 "$rollback_release_input"
    if ! "$jq_bin" -eS --arg operation_id "$request_operation_id" -f "$journal_validator" "$rollback_release_input" >/dev/null 2>&1 ||
       ! native_run journal-replace "$state_root" "$request_operation_id" "$rollback_release_input" rollback-authority-observed >/dev/null 2>&1; then
      /usr/bin/rm -f -- "$rollback_release_input"
      emit_error indeterminate rollback-release-authority-indeterminate 5 ROLLBACK_STARTED
    fi
    /usr/bin/rm -f -- "$rollback_release_input"
    read_journal_authoritative || emit_error indeterminate rollback-release-authority-indeterminate 5 ROLLBACK_STARTED
    shell_call releaseRollbackTransactionPlugin "$request_operation_id" "$request_plugin_id" >/dev/null 2>&1 ||
      emit_error indeterminate rollback-release-indeterminate 5 ROLLBACK_STARTED
    wait_shell_transaction_status released || true
    wait_gate_state RELEASE_AUTHORIZED ||
      emit_error indeterminate rollback-release-indeterminate 5 ROLLBACK_STARTED
    shell_call transactionTerminalReceipt "$request_operation_id" "$request_plugin_id" ROLLED_BACK >/dev/null 2>&1 ||
      emit_error indeterminate rollback-release-indeterminate 5 ROLLBACK_STARTED
    wait_gate_state TERMINAL_RECEIPT ||
      emit_error indeterminate rollback-release-indeterminate 5 ROLLBACK_STARTED
  fi
  reconcile_terminal_shell ||
    emit_error indeterminate terminal-shell-reconciliation-required 5 ROLLBACK_STARTED
  if ! acquire_ordered_locks || ! read_journal_held; then
    release_ordered_locks
    emit_error indeterminate rollback-authority-indeterminate 5 ROLLBACK_STARTED
  fi
  gate_path=$state_root/gates/$request_plugin_id.gate
  if ! "$jq_bin" -e --arg binding "$(printf '%s' "$journal" | "$jq_bin" -r '.operationBindingSha256')" --arg op "$request_operation_id" --arg plugin "$request_plugin_id" \
      '.state == "TERMINAL_RECEIPT" and .terminalReceipt.state == "durable" and .terminalReceipt.intendedJournalState == "ROLLED_BACK" and .operationBindingSha256 == $binding and .operationId == $op and .pluginId == $plugin' "$gate_path" >/dev/null 2>&1; then
    release_ordered_locks
    emit_error indeterminate rollback-release-indeterminate 5 ROLLBACK_STARTED
  fi
  terminal_shell=$("$jq_bin" -r '.release.shellInstance' "$gate_path")
  terminal_generation=$("$jq_bin" -r '.release.generation' "$gate_path")
  terminal_configuration_epoch=$("$jq_bin" -r '.release.configurationEpoch' "$gate_path")
  rollback_input=$(/usr/bin/mktemp /tmp/omarchy-plugin-journal-rolled-back.XXXXXX)
  printf '%s' "$journal" | "$jq_bin" -cS --slurpfile receipt "$gate_path" --arg shell "$terminal_shell" --argjson generation "$terminal_generation" --argjson configurationEpoch "$terminal_configuration_epoch" \
    '.state="ROLLED_BACK" | .rollback="completed" | .terminalReceipt=$receipt[0].terminalReceipt | .release={outcome:"authorized",shellInstance:$shell,generation:$generation,configurationEpoch:$configurationEpoch,source:.release.source,rawSha256:.release.rawSha256,referenceProjection:.release.referenceProjection,referenceState:.release.referenceState,referencePolicy:.release.referencePolicy}' >"$rollback_input"
  chmod 0600 "$rollback_input"
  if ! "$jq_bin" -eS --arg operation_id "$request_operation_id" -f "$journal_validator" "$rollback_input" >/dev/null 2>&1 ||
     ! native_run journal-replace "$state_root" "$request_operation_id" "$rollback_input" rollback-started-to-rolled-back >/dev/null 2>&1; then
    /usr/bin/rm -f -- "$rollback_input"
    release_ordered_locks
    emit_error indeterminate rollback-journal-indeterminate 5 ROLLBACK_STARTED
  fi
  /usr/bin/rm -f -- "$rollback_input"
  read_journal_held || { release_ordered_locks; emit_error indeterminate rollback-journal-indeterminate 5 ROLLBACK_STARTED; }
  release_ordered_locks
  commit_result_from_journal ROLLED_BACK
}

reject_competing_operation() {
  local other_operation=$1 op_read op_write op_pid ready input gate_path gate_operation gate_plugin read_status
  local gate_binding other_journal other_binding candidate_path expected_candidate operation destination
  local active_state active_identity
  gate_path=$state_root/gates/$request_plugin_id.gate
  [[ -f $gate_path && ! -L $gate_path ]] || return 1
  # A visible gate is not enough evidence after a possible interrupted rename.
  # Reconcile the existing gate directory before treating it as another
  # operation's durable authority.
  native_run gate-sync "$state_root" >/dev/null 2>&1 || return 2
  "$jq_bin" -e --arg plugin_id "$request_plugin_id" -f "$gate_validator" "$gate_path" >/dev/null 2>&1 || return 2
  gate_operation=$("$jq_bin" -r '.operationId // ""' "$gate_path")
  gate_plugin=$("$jq_bin" -r '.pluginId // ""' "$gate_path")
  gate_binding=$("$jq_bin" -r '.operationBindingSha256 // ""' "$gate_path")
  [[ $gate_operation != "$request_operation_id" && $gate_plugin == "$request_plugin_id" &&
      $gate_operation =~ ^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$ &&
      $gate_binding =~ ^[0-9a-f]{64}$ ]] || return 2
  # Bind the observed gate to the other operation's authoritative journal;
  # a gate with no readable matching journal is ambiguous, never a rejection.
  if ! other_journal=$(native_run journal-read-locked "$state_root" "$gate_operation" 2>/dev/null); then
    return 2
  fi
  [[ $(printf '%s' "$other_journal" | "$jq_bin" -r '.schema // ""') == omarchy-plugin-transaction-journal/v2 ]] || return 2
  "$jq_bin" -eS --arg operation_id "$gate_operation" -f "$journal_validator" \
    <(printf '%s' "$other_journal") >/dev/null 2>&1 || return 2
  other_binding=$(printf '%s' "$other_journal" | "$jq_bin" -cS '
    {operationId,pluginId,
     operation: .normalizedRequest.facts.operation,
     requestDigest: .normalizedRequest.digest,
     candidateExpected: .candidate.expected,
     candidateObserved: .candidate.observed,
     candidateSlot: .candidate.completedSlot,
     expectedActive: .normalizedRequest.facts.expectedActive,
     destination: .normalizedRequest.facts.destination}' |
    native_run domain-hash omarchy-plugin-transaction-operation-binding/v1 2>/dev/null) || return 2
  [[ $other_binding == "$gate_binding" ]] || return 2

  coproc O8_OPERATION_LOCK { native_run operation-lock "$state_root" "$request_operation_id"; }
  op_pid=$O8_OPERATION_LOCK_PID
  op_read=${O8_OPERATION_LOCK[0]}
  op_write=${O8_OPERATION_LOCK[1]}
  if IFS= read -r -t "$lock_timeout_seconds" ready <&"$op_read"; then
    :
  else
    read_status=$?
    exec {op_read}<&- || true; exec {op_write}>&- || true; wait "$op_pid" 2>/dev/null || true
    (( read_status == 142 )) && return 2
    return 1
  fi
  [[ $ready == locked-operation ]] || {
    exec {op_write}>&- || true; wait "$op_pid" 2>/dev/null || true
    return 1
  }
  exec {op_read}<&-
  if ! read_journal_held; then
    exec {op_write}>&-; wait "$op_pid" 2>/dev/null || true
    return 1
  fi
  if [[ $(printf '%s' "$journal" | "$jq_bin" -r '.state') != COMMIT_PREPARED ||
        $(printf '%s' "$journal" | "$jq_bin" -r '.namespaceIntent.state') != none ||
        $(printf '%s' "$journal" | "$jq_bin" -r '.gate') != not-established ||
        $(printf '%s' "$journal" | "$jq_bin" -r '.rollback') != not-applicable ]]; then
    exec {op_write}>&-; wait "$op_pid" 2>/dev/null || true
    return 2
  fi
  candidate_path=$candidate_store/$request_operation_id/candidate
  expected_candidate=$(printf '%s' "$journal" | "$jq_bin" -r '.candidate.observed // ""')
  [[ -d $candidate_path && ! -L $candidate_path &&
      $(native_run identity "$candidate_path" 2>/dev/null || true) == "$expected_candidate" ]] || {
    exec {op_write}>&-; wait "$op_pid" 2>/dev/null || true
    return 2
  }
  operation=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.operation')
  destination=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.destination')
  active_state=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedActive.state')
  active_identity=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedActive.identity // ""')
  if [[ $operation == install ]]; then
    [[ $destination == "$discovery_dir/$request_plugin_id" && ! -e $destination && ! -L $destination ]] || {
      exec {op_write}>&-; wait "$op_pid" 2>/dev/null || true
      return 2
    }
  elif [[ $operation == update ]]; then
    validate_update_destination "$destination" && [[ $active_state == present && -d $destination && ! -L $destination &&
      $(native_run identity "$destination" 2>/dev/null || true) == "$active_identity" ]] || {
      exec {op_write}>&-; wait "$op_pid" 2>/dev/null || true
      return 2
    }
  else
    exec {op_write}>&-; wait "$op_pid" 2>/dev/null || true
    return 2
  fi
  input=$(/usr/bin/mktemp /tmp/omarchy-plugin-journal-rejected.XXXXXX)
  printf '%s' "$journal" | "$jq_bin" -cS '.state="REJECTED" | .reason="plugin-gated-by-another-operation"' >"$input"
  chmod 0600 "$input"
  if ! "$jq_bin" -eS --arg operation_id "$request_operation_id" -f "$journal_validator" "$input" >/dev/null 2>&1 || ! native_run journal-replace "$state_root" "$request_operation_id" "$input" commit-prepared-to-rejected >/dev/null 2>&1; then
    /usr/bin/rm -f -- "$input"; exec {op_write}>&-; wait "$op_pid" 2>/dev/null || true
    return 1
  fi
  /usr/bin/rm -f -- "$input"
  exec {op_write}>&-
  wait "$op_pid" 2>/dev/null || true
  read_journal_authoritative || return 1
  emit_journal_response commit
  exit 0
}

commit_operation() {
  local stored_capability supplied_capability state operation destination candidate_path source_parent source_name dest_parent dest_name
  local expected_candidate expected_active active_state active_identity mutation_result mutation_status
  local competing_status
  if ! read_journal_authoritative; then
    [[ $journal_read_error == operation-not-found ]] && emit_error not-found operation-not-found 0
    [[ $journal_read_error == durability-indeterminate ]] && emit_error indeterminate journal-authority-indeterminate 5
    emit_error manual-attention invalid-state 4
  fi
  stored_capability=$(printf '%s' "$journal" | "$jq_bin" -r '.capabilityHash // ""')
  [[ $stored_capability =~ ^[0-9a-f]{64}$ ]] || emit_error manual-attention invalid-state 4
  if ! supplied_capability=$(printf '%s' "$operation_token" | native_run domain-hash omarchy-plugin-transaction-capability/v1 2>/dev/null); then
    unset operation_token
    emit_error unavailable local-io-failure 4
  fi
  unset operation_token
  if ! printf '%s' "$supplied_capability" | native_run hash-equal "$stored_capability"; then
    unset supplied_capability stored_capability
    emit_error rejected invalid-operation-token 3
  fi
  unset supplied_capability stored_capability
  request_plugin_id=$(printf '%s' "$journal" | "$jq_bin" -r '.pluginId // ""')
  [[ -n $request_plugin_id ]] || emit_error manual-attention invalid-state 4
  state=$(printf '%s' "$journal" | "$jq_bin" -r '.state')
  if ! load_commit_context_from_journal; then
    emit_error manual-attention invalid-state 4 "$state"
  fi
  if [[ $(printf '%s' "$journal" | "$jq_bin" -r '.schema') == omarchy-plugin-transaction-journal/v1 ]]; then
    [[ $state == STAGED ]] || commit_result_from_journal "$state"
  else
    case $state in
      COMMITTED|ROLLED_BACK|REJECTED|RECOVERY_REQUIRED|MANUAL_ATTENTION) commit_result_from_journal "$state" ;;
      ABORTED) emit_error rejected operation-aborted 3 "$state" ;;
      STAGED) : ;;
      COMMIT_PREPARED|LOAD_GATED|LIVE_TREE_EXCHANGED|GATED_RESCAN_COMPLETED|RELEASE_PENDING) : ;;
      ROLLBACK_STARTED) rollback_operation exact-rollback-retry ;;
      *) emit_error manual-attention invalid-state 4 "$state" ;;
    esac
  fi

  # COMMIT_PREPARED is only a reservation. Before installing a gate, obtain
  # one fresh O-6 shell observation and compare every immutable precondition.
  # A journal already exists at this point, so stale facts are reported as an
  # in-progress durable operation rather than a fabricated terminal rejection.
  if [[ $state == STAGED || $state == COMMIT_PREPARED ]]; then
    request_plugin_id=$(printf '%s' "$journal" | "$jq_bin" -r '.pluginId')
    operation_kind=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.operation')
    destination=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.destination')
    active_state=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedActive.state')
    active_identity=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedActive.identity // ""')
    expected_config_kind=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedConfiguration.source.kind')
    expected_config_identity=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedConfiguration.source.identity')
    expected_projection=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedConfiguration.referenceProjection')
    expected_reference_state=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedConfiguration.referenceState')
    reference_policy=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedConfiguration.referencePolicy')
    set +e
    commit_validate_authority
    authority_status=$?
    set -e
    if (( authority_status != 0 )); then
      if (( authority_status == 1 )); then
        emit_error unavailable "${authority_reason:-shell-authority-unavailable}" 4 "$state"
      fi
      if [[ -n ${authority_reason:-} ]]; then
        if [[ $state == STAGED ]]; then
          reject_staged "$authority_reason"
        else
          reject_prepared "$authority_reason"
        fi
      fi
      emit_error indeterminate "${authority_reason:-precondition-indeterminate}" 5 "$state"
    fi
  fi

  set +e
  acquire_ordered_locks
  lock_status=$?
  set -e
  if (( lock_status != 0 )); then
    (( lock_status == 5 )) && emit_error indeterminate lock-timeout 5 COMMIT_PREPARED
    if (( lock_status == 3 )); then
      if reject_competing_operation other; then
        :
      else
        competing_status=$?
        if (( competing_status == 2 )); then
          emit_error indeterminate competing-operation-ambiguous 5 COMMIT_PREPARED
        fi
        emit_error unavailable lock-failure 4 COMMIT_PREPARED
      fi
    fi
    emit_error unavailable lock-failure 4
  fi
  if ! read_journal_held; then
    release_ordered_locks
    emit_error indeterminate journal-authority-indeterminate 5
  fi
  state=$(printf '%s' "$journal" | "$jq_bin" -r '.state')
  if [[ $state == STAGED ]]; then
    if ! make_commit_prepared; then
      release_ordered_locks
      emit_error unavailable commit-preparation-failed 4
    fi
    state=COMMIT_PREPARED
  fi
  if [[ $state == LOAD_GATED ]]; then
    expected_candidate=$(printf '%s' "$journal" | "$jq_bin" -r '.candidate.observed')
    destination=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.destination')
    operation=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.operation')
    active_identity=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedActive.identity // ""')
  fi
  if [[ $state == COMMIT_PREPARED || $state == LOAD_GATED ]]; then
    if [[ $state == COMMIT_PREPARED ]]; then
    candidate_path=$candidate_store/$request_operation_id/candidate
    expected_candidate=$(printf '%s' "$journal" | "$jq_bin" -r '.candidate.observed')
    [[ -d $candidate_path && ! -L $candidate_path ]] || reject_prepared stale-candidate
    [[ $(native_run identity "$candidate_path" 2>/dev/null || true) == "$expected_candidate" ]] || reject_prepared stale-candidate
    destination=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.destination')
    operation=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.operation')
    active_state=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedActive.state')
    active_identity=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedActive.identity // ""')
    if [[ $operation == install ]]; then
      [[ $destination == "$discovery_dir/$request_plugin_id" && ! -e $destination && ! -L $destination ]] || reject_prepared stale-active-tree
    else
      validate_update_destination "$destination" || reject_prepared stale-active-tree
      [[ -d $destination && ! -L $destination ]] || reject_prepared stale-active-tree
      [[ $(native_run identity "$destination" 2>/dev/null || true) == "$active_identity" ]] || reject_prepared stale-active-tree
    fi
    if ! native_run atomic-support >/dev/null 2>&1 ||
       [[ $(stat -c %d "$candidate_store/$request_operation_id" 2>/dev/null || true) != "$(stat -c %d "$discovery_dir" 2>/dev/null || true)" ]]; then
      if ! write_journal_transition commit-prepared-to-staged '.state="STAGED" | .reason=null'; then
        release_ordered_locks
        emit_error indeterminate journal-indeterminate 5 COMMIT_PREPARED
      fi
      release_ordered_locks
      emit_error unavailable unsupported-atomic-operation 4 STAGED
    fi
    release_ordered_locks
    if ! shell_call gateTransactionPlugin "$request_operation_id" "$request_plugin_id" >/dev/null 2>&1; then
      emit_error unavailable shell-authority-unavailable 4 COMMIT_PREPARED
    fi
    wait_shell_transaction_status gate-installed-unload-acknowledged || true
    if ! wait_gate_state UNLOAD_ACKNOWLEDGED; then
      current_gate=$(read_gate_state "$request_plugin_id" 2>/dev/null || true)
      [[ $current_gate == GATED ]] && emit_error in-progress unload-pending 0 COMMIT_PREPARED
      emit_error indeterminate unload-acknowledgement-indeterminate 5 COMMIT_PREPARED
    fi
    if ! acquire_ordered_locks || ! read_journal_held; then
      release_ordered_locks
      emit_error indeterminate journal-authority-indeterminate 5
    fi
    [[ $(printf '%s' "$journal" | "$jq_bin" -r '.state') == COMMIT_PREPARED ]] || { release_ordered_locks; emit_error manual-attention operation-state-mismatch 4; }
    gate_path=$state_root/gates/$request_plugin_id.gate
    [[ -f $gate_path ]] || { release_ordered_locks; emit_error indeterminate gate-missing 5; }
    [[ $(read_gate_state "$request_plugin_id") == UNLOAD_ACKNOWLEDGED ]] || { release_ordered_locks; emit_error indeterminate unload-acknowledgement-indeterminate 5; }
    # The unload acknowledgement is a barrier, not a pre-exposure authority
    # snapshot.  Re-read the same O-6 producer while the ordered locks are
    # held, immediately before recording LOAD_GATED and exposing the tree.
    # The observation itself is a shell IPC read and must not run while the
    # coordinator's transaction locks are held; release and reacquire them
    # around that bounded read, then validate the durable gate again.
    expected_candidate=$(printf '%s' "$journal" | "$jq_bin" -r '.candidate.observed')
    release_ordered_locks
    authority_phase=pre
    set +e
    commit_validate_authority
    authority_status=$?
    set -e
    if ! acquire_ordered_locks || ! read_journal_held; then
      release_ordered_locks
      emit_error indeterminate journal-authority-indeterminate 5 COMMIT_PREPARED
    fi
    gate_path=$state_root/gates/$request_plugin_id.gate
    [[ -f $gate_path && $(read_gate_state "$request_plugin_id") == UNLOAD_ACKNOWLEDGED ]] || {
      release_ordered_locks
      emit_error indeterminate unload-acknowledgement-indeterminate 5 COMMIT_PREPARED
    }
    [[ $(jq -r '.operationId' "$gate_path") == "$request_operation_id" &&
       $(jq -r '.pluginId' "$gate_path") == "$request_plugin_id" &&
       $(jq -r '.operationBindingSha256 // ""' "$gate_path") == $(printf '%s' "$journal" | "$jq_bin" -r '.operationBindingSha256') ]] || {
      release_ordered_locks
      emit_error manual-attention operation-binding-mismatch 4 COMMIT_PREPARED
    }
    [[ $(printf '%s' "$journal" | "$jq_bin" -r '.state') == COMMIT_PREPARED ]] || {
      release_ordered_locks
      emit_error manual-attention operation-state-mismatch 4 COMMIT_PREPARED
    }
    if (( authority_status != 0 )); then
      reason=${authority_reason:-pre-exposure-authority-indeterminate}
      mark_recovery "pre-exposure-$reason" COMMIT_PREPARED
    fi
    if ! write_journal_transition commit-prepared-to-load-gated '.state="LOAD_GATED" | .gate="established" | .namespaceIntent.state="intended"'; then
      release_ordered_locks
      emit_error indeterminate journal-indeterminate 5
    fi
    else
      gate_path=$state_root/gates/$request_plugin_id.gate
      [[ -f $gate_path && ! -L $gate_path ]] || { release_ordered_locks; emit_error indeterminate gate-missing 5 LOAD_GATED; }
      [[ $(read_gate_state "$request_plugin_id") == UNLOAD_ACKNOWLEDGED ]] || { release_ordered_locks; emit_error indeterminate unload-acknowledgement-indeterminate 5 LOAD_GATED; }
      [[ $(printf '%s' "$journal" | "$jq_bin" -r '.namespaceIntent.state') == intended &&
         $(printf '%s' "$journal" | "$jq_bin" -r '.gate') == established &&
         $(jq -r .operationBindingSha256 "$gate_path") == $(printf '%s' "$journal" | "$jq_bin" -r '.operationBindingSha256') ]] || {
        release_ordered_locks
        emit_error manual-attention operation-binding-mismatch 4 LOAD_GATED
      }
      expected_candidate=$(printf '%s' "$journal" | "$jq_bin" -r '.candidate.observed')
      release_ordered_locks
      authority_phase=pre
      set +e
      commit_validate_authority
      authority_status=$?
      set -e
      if ! acquire_ordered_locks || ! read_journal_held; then
        release_ordered_locks
        emit_error indeterminate journal-authority-indeterminate 5 LOAD_GATED
      fi
      gate_path=$state_root/gates/$request_plugin_id.gate
      [[ -f $gate_path && $(read_gate_state "$request_plugin_id") == UNLOAD_ACKNOWLEDGED ]] || {
        release_ordered_locks
        emit_error indeterminate unload-acknowledgement-indeterminate 5 LOAD_GATED
      }
      [[ $(jq -r '.operationId' "$gate_path") == "$request_operation_id" &&
         $(jq -r '.pluginId' "$gate_path") == "$request_plugin_id" &&
         $(jq -r '.operationBindingSha256 // ""' "$gate_path") == $(printf '%s' "$journal" | "$jq_bin" -r '.operationBindingSha256') ]] || {
        release_ordered_locks
        emit_error manual-attention operation-binding-mismatch 4 LOAD_GATED
      }
      [[ $(printf '%s' "$journal" | "$jq_bin" -r '.state') == LOAD_GATED ]] || {
        release_ordered_locks
        emit_error manual-attention operation-state-mismatch 4 LOAD_GATED
      }
      if (( authority_status != 0 )); then
        reason=${authority_reason:-pre-exposure-authority-indeterminate}
        mark_recovery "pre-exposure-$reason" LOAD_GATED
      fi
    fi
    destination=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.destination')
    source_parent=$candidate_store/$request_operation_id
    source_name=candidate
    dest_parent=$(/usr/bin/dirname -- "$destination")
    dest_name=$(/usr/bin/basename -- "$destination")
    if [[ $operation == install ]]; then
      mutation_result=$(native_run namespace-mutate install "$source_parent" "$source_name" "$dest_parent" "$dest_name" "$expected_candidate" "$expected_candidate" 2>/dev/null) || mutation_status=$?
    else
      mutation_result=$(native_run namespace-mutate exchange "$source_parent" "$source_name" "$dest_parent" "$dest_name" "$expected_candidate" "$active_identity" 2>/dev/null) || mutation_status=$?
    fi
    mutation_status=${mutation_status:-0}
    mutation_outcome=$(printf '%s' "$mutation_result" | "$jq_bin" -r '.status // "invalid-result"' 2>/dev/null || printf '%s' invalid-result)
    if (( mutation_status != 0 )); then
      case $mutation_status in
        2) mark_recovery stale-namespace-precondition LOAD_GATED ;;
        3) mark_recovery namespace-not-performed LOAD_GATED ;;
        4) mark_recovery unsupported-atomic-operation LOAD_GATED ;;
        5) mark_recovery namespace-indeterminate LOAD_GATED ;;
        *) mark_recovery namespace-io-failure LOAD_GATED ;;
      esac
    fi
    case $mutation_outcome in
      completed-durable) : ;;
      completed-and-exactly-compensated) mark_recovery namespace-compensated LOAD_GATED ;;
      stale-candidate|stale-active-tree|destination-unexpectedly-present|exact-postcheck-mismatch|definitely-not-performed)
        mark_recovery namespace-not-performed LOAD_GATED ;;
      unsupported-atomic-operation) mark_recovery unsupported-atomic-operation LOAD_GATED ;;
      indeterminate-namespace|invalid-result) mark_recovery namespace-indeterminate LOAD_GATED ;;
      *) mark_recovery namespace-io-failure LOAD_GATED ;;
    esac
    if [[ $operation == update ]]; then
      live_input=$(/usr/bin/mktemp /tmp/omarchy-plugin-journal-live.XXXXXX)
      printf '%s' "$journal" | "$jq_bin" -cS --arg prior "$active_identity" --arg slot "$request_operation_id" \
        '.namespaceIntent.state="completed" | .state="LIVE_TREE_EXCHANGED" | .retainedPrior={state:"captured",identity:$prior,slot:$slot}' >"$live_input"
    else
      live_input=$(/usr/bin/mktemp /tmp/omarchy-plugin-journal-live.XXXXXX)
      printf '%s' "$journal" | "$jq_bin" -cS '.namespaceIntent.state="completed" | .state="LIVE_TREE_EXCHANGED" | .retainedPrior={state:"absent",identity:null,slot:null}' >"$live_input"
    fi
    chmod 0600 "$live_input"
    if ! "$jq_bin" -eS --arg operation_id "$request_operation_id" -f "$journal_validator" "$live_input" >/dev/null 2>&1 || ! native_run journal-replace "$state_root" "$request_operation_id" "$live_input" load-gated-to-live-tree-exchanged >/dev/null 2>&1; then
      /usr/bin/rm -f -- "$live_input"
      release_ordered_locks
      emit_error indeterminate journal-indeterminate 5 LIVE_TREE_EXCHANGED
    fi
    /usr/bin/rm -f -- "$live_input"
    read_journal_held
    release_ordered_locks
  fi
  state=$(printf '%s' "$journal" | "$jq_bin" -r '.state')
  if [[ $state == LIVE_TREE_EXCHANGED ]]; then
    shell_call rescanGatedPlugin "$request_operation_id" "$request_plugin_id" >/dev/null 2>&1 || rollback_operation rescan-request-failed
    wait_shell_transaction_status gated-rescan-complete || true
    wait_gate_state RESCAN_ACKNOWLEDGED || rollback_operation rescan-acknowledgement-indeterminate
    require_ordered_locks LIVE_TREE_EXCHANGED
    read_journal_held || { release_ordered_locks; emit_error indeterminate journal-authority-indeterminate 5; }
    gate_path=$state_root/gates/$request_plugin_id.gate
    rescan_shell=$("$jq_bin" -r '.rescan.shellInstance' "$gate_path")
    rescan_generation=$("$jq_bin" -r '.rescan.generation' "$gate_path")
    rescan_epoch=$("$jq_bin" -r '.rescan.scanEpoch' "$gate_path")
    rescan_source=$("$jq_bin" -r '.rescan.sourceDirectory' "$gate_path")
    rescan_input=$(/usr/bin/mktemp /tmp/omarchy-plugin-journal-rescan.XXXXXX)
    printf '%s' "$journal" | "$jq_bin" -cS --arg shell "$rescan_shell" --argjson generation "$rescan_generation" --argjson scanEpoch "$rescan_epoch" --arg source "$rescan_source" \
      '.rescan={outcome:"completed",shellInstance:$shell,generation:$generation,scanEpoch:$scanEpoch,sourceDirectory:$source,expectedTree:.candidate.observed,observedTree:.candidate.observed} | .state="GATED_RESCAN_COMPLETED"' >"$rescan_input"
    chmod 0600 "$rescan_input"
    "$jq_bin" -eS --arg operation_id "$request_operation_id" -f "$journal_validator" "$rescan_input" >/dev/null 2>&1 || { /usr/bin/rm -f -- "$rescan_input"; release_ordered_locks; emit_error manual-attention invalid-generated-state 4; }
    native_run journal-replace "$state_root" "$request_operation_id" "$rescan_input" live-tree-to-gated-rescan >/dev/null 2>&1 || { /usr/bin/rm -f -- "$rescan_input"; release_ordered_locks; emit_error indeterminate journal-indeterminate 5; }
    /usr/bin/rm -f -- "$rescan_input"
    read_journal_held
    # Rescan acknowledgement is not a release snapshot.  Re-read the
    # authoritative O-6 configuration and exact live candidate immediately
    # before RELEASE_PENDING is made durable.
    operation_kind=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.operation')
    destination=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.destination')
    expected_candidate=$(printf '%s' "$journal" | "$jq_bin" -r '.candidate.observed')
    expected_config_kind=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedConfiguration.source.kind')
    expected_config_identity=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedConfiguration.source.identity')
    expected_projection=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedConfiguration.referenceProjection')
    expected_reference_state=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedConfiguration.referenceState')
    reference_policy=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedConfiguration.referencePolicy')
    # Final authority observation is a shell IPC read, not a transaction-lock
    # operation.  Do not hold the ordered coordinator locks while obtaining
    # it; reacquire and revalidate the exact rescan gate before persisting
    # RELEASE_PENDING.
    release_ordered_locks
    authority_phase=post
    set +e
    commit_validate_authority
    authority_status=$?
    set -e
    if ! acquire_ordered_locks || ! read_journal_held; then
      release_ordered_locks
      emit_error indeterminate journal-authority-indeterminate 5 GATED_RESCAN_COMPLETED
    fi
    gate_path=$state_root/gates/$request_plugin_id.gate
    [[ -f $gate_path && $(read_gate_state "$request_plugin_id") == RESCAN_ACKNOWLEDGED ]] || {
      release_ordered_locks
      emit_error indeterminate gated-rescan-authority-indeterminate 5 GATED_RESCAN_COMPLETED
    }
    [[ $(jq -r '.operationId' "$gate_path") == "$request_operation_id" &&
       $(jq -r '.pluginId' "$gate_path") == "$request_plugin_id" &&
       $(jq -r '.operationBindingSha256 // ""' "$gate_path") == $(printf '%s' "$journal" | "$jq_bin" -r '.operationBindingSha256') ]] || {
      release_ordered_locks
      emit_error manual-attention operation-binding-mismatch 4 GATED_RESCAN_COMPLETED
    }
    [[ $(printf '%s' "$journal" | "$jq_bin" -r '.state') == GATED_RESCAN_COMPLETED ]] || {
      release_ordered_locks
      emit_error manual-attention operation-state-mismatch 4 GATED_RESCAN_COMPLETED
    }
    if (( authority_status != 0 )); then
      reason=${authority_reason:-release-precondition-indeterminate}
      release_ordered_locks
      rollback_operation "release-precondition-$reason"
    fi
    release_input=$(/usr/bin/mktemp /tmp/omarchy-plugin-journal-release.XXXXXX)
    printf '%s' "$journal" | "$jq_bin" -cS --arg kind "$authority_observed_kind" --arg identity "$authority_observed_identity" --arg raw "$authority_observed_raw_hash" --arg projection "$authority_observed_projection_hash" --arg referenceState "$authority_observed_reference_state" --argjson epoch "$authority_observed_epoch" \
      '.state="RELEASE_PENDING" | .release={outcome:"not-requested",shellInstance:null,generation:null,configurationEpoch:$epoch,source:{kind:$kind,identity:$identity},rawSha256:$raw,referenceProjection:$projection,referenceState:$referenceState,referencePolicy:.normalizedRequest.facts.expectedConfiguration.referencePolicy}' >"$release_input"
    chmod 0600 "$release_input"
    "$jq_bin" -eS --arg operation_id "$request_operation_id" -f "$journal_validator" "$release_input" >/dev/null 2>&1 || { /usr/bin/rm -f -- "$release_input"; release_ordered_locks; emit_error manual-attention invalid-generated-state 4; }
    native_run journal-replace "$state_root" "$request_operation_id" "$release_input" gated-rescan-to-release-pending >/dev/null 2>&1 || { /usr/bin/rm -f -- "$release_input"; release_ordered_locks; emit_error indeterminate journal-indeterminate 5; }
    /usr/bin/rm -f -- "$release_input"
    read_journal_held
    release_ordered_locks
  fi
  state=$(printf '%s' "$journal" | "$jq_bin" -r '.state')
  if [[ $state == GATED_RESCAN_COMPLETED ]]; then
    if ! acquire_ordered_locks || ! read_journal_held; then
      release_ordered_locks
      emit_error indeterminate journal-authority-indeterminate 5 GATED_RESCAN_COMPLETED
    fi
    gate_path=$state_root/gates/$request_plugin_id.gate
    [[ -f $gate_path && ! -L $gate_path && $(read_gate_state "$request_plugin_id") == RESCAN_ACKNOWLEDGED ]] || {
      release_ordered_locks
      emit_error indeterminate gated-rescan-authority-indeterminate 5 GATED_RESCAN_COMPLETED
    }
    [[ $(jq -r .operationBindingSha256 "$gate_path") == $(printf '%s' "$journal" | "$jq_bin" -r '.operationBindingSha256') ]] || {
      release_ordered_locks
      emit_error manual-attention operation-binding-mismatch 4 GATED_RESCAN_COMPLETED
    }
    operation_kind=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.operation')
    destination=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.destination')
    expected_candidate=$(printf '%s' "$journal" | "$jq_bin" -r '.candidate.observed')
    expected_config_kind=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedConfiguration.source.kind')
    expected_config_identity=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedConfiguration.source.identity')
    expected_projection=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedConfiguration.referenceProjection')
    expected_reference_state=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedConfiguration.referenceState')
    reference_policy=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedConfiguration.referencePolicy')
    authority_phase=post
    set +e
    commit_validate_authority
    authority_status=$?
    set -e
    if (( authority_status != 0 )); then
      reason=${authority_reason:-release-precondition-indeterminate}
      release_ordered_locks
      rollback_operation "release-precondition-$reason"
    fi
    release_input=$(/usr/bin/mktemp /tmp/omarchy-plugin-journal-release.XXXXXX)
    printf '%s' "$journal" | "$jq_bin" -cS --arg kind "$authority_observed_kind" --arg identity "$authority_observed_identity" --arg raw "$authority_observed_raw_hash" --arg projection "$authority_observed_projection_hash" --arg referenceState "$authority_observed_reference_state" --argjson epoch "$authority_observed_epoch" \
      '.state="RELEASE_PENDING" | .release={outcome:"not-requested",shellInstance:null,generation:null,configurationEpoch:$epoch,source:{kind:$kind,identity:$identity},rawSha256:$raw,referenceProjection:$projection,referenceState:$referenceState,referencePolicy:.normalizedRequest.facts.expectedConfiguration.referencePolicy}' >"$release_input"
    chmod 0600 "$release_input"
    if ! "$jq_bin" -eS --arg operation_id "$request_operation_id" -f "$journal_validator" "$release_input" >/dev/null 2>&1 ||
       ! native_run journal-replace "$state_root" "$request_operation_id" "$release_input" gated-rescan-to-release-pending >/dev/null 2>&1; then
      /usr/bin/rm -f -- "$release_input"
      release_ordered_locks
      emit_error indeterminate journal-indeterminate 5 GATED_RESCAN_COMPLETED
    fi
    /usr/bin/rm -f -- "$release_input"
    read_journal_held || { release_ordered_locks; emit_error indeterminate journal-authority-indeterminate 5 GATED_RESCAN_COMPLETED; }
    release_ordered_locks
  fi
  state=$(printf '%s' "$journal" | "$jq_bin" -r '.state')
  if [[ $state == RELEASE_PENDING ]]; then
    terminal_gate_state=$(read_gate_state "$request_plugin_id" 2>/dev/null || true)
    if [[ $terminal_gate_state != TERMINAL_RECEIPT ]]; then
      shell_call releaseTransactionPlugin "$request_operation_id" "$request_plugin_id" >/dev/null 2>&1 || rollback_operation release-request-failed
      wait_shell_transaction_status released || true
      terminal_gate_state=$(read_gate_state "$request_plugin_id" 2>/dev/null || true)
      if [[ $terminal_gate_state != TERMINAL_RECEIPT ]]; then
        wait_gate_state RELEASE_AUTHORIZED || rollback_operation release-acknowledgement-indeterminate
      fi
      # The real shell requests the terminal receipt only after it has
      # published in-memory eligibility.  The coordinator must wait for that
      # authoritative durable handoff rather than issuing a receipt request
      # while the release callback is still pending.
      wait_gate_state TERMINAL_RECEIPT || rollback_operation terminal-receipt-indeterminate
    fi
    reconcile_terminal_shell || emit_error indeterminate terminal-shell-reconciliation-required 5 RELEASE_PENDING
    require_ordered_locks RELEASE_PENDING
    read_journal_held || { release_ordered_locks; emit_error indeterminate journal-authority-indeterminate 5; }
    gate_path=$state_root/gates/$request_plugin_id.gate
    "$jq_bin" -e --arg binding "$(printf '%s' "$journal" | "$jq_bin" -r '.operationBindingSha256')" --arg op "$request_operation_id" --arg plugin "$request_plugin_id" '.state == "TERMINAL_RECEIPT" and .terminalReceipt.state == "durable" and .terminalReceipt.intendedJournalState == "COMMITTED" and .operationBindingSha256 == $binding and .operationId == $op and .pluginId == $plugin' "$gate_path" >/dev/null 2>&1 || { release_ordered_locks; rollback_operation terminal-receipt-mismatch; }
    terminal_shell=$("$jq_bin" -r '.release.shellInstance' "$gate_path")
    terminal_generation=$("$jq_bin" -r '.release.generation' "$gate_path")
    terminal_configuration_epoch=$("$jq_bin" -r '.release.configurationEpoch' "$gate_path")
    committed_input=$(/usr/bin/mktemp /tmp/omarchy-plugin-journal-committed.XXXXXX)
    printf '%s' "$journal" | "$jq_bin" -cS --slurpfile receipt "$gate_path" --arg shell "$terminal_shell" --argjson generation "$terminal_generation" --argjson configurationEpoch "$terminal_configuration_epoch" \
      '.state="COMMITTED" | .terminalReceipt=$receipt[0].terminalReceipt | .release={outcome:"authorized",shellInstance:$shell,generation:$generation,configurationEpoch:$configurationEpoch,source:.release.source,rawSha256:.release.rawSha256,referenceProjection:.release.referenceProjection,referenceState:.release.referenceState,referencePolicy:.release.referencePolicy}' >"$committed_input"
    chmod 0600 "$committed_input"
    "$jq_bin" -eS --arg operation_id "$request_operation_id" -f "$journal_validator" "$committed_input" >/dev/null 2>&1 || { /usr/bin/rm -f -- "$committed_input"; release_ordered_locks; emit_error manual-attention invalid-generated-state 4; }
    native_run journal-replace "$state_root" "$request_operation_id" "$committed_input" release-pending-to-committed >/dev/null 2>&1 || { /usr/bin/rm -f -- "$committed_input"; release_ordered_locks; emit_error indeterminate journal-indeterminate 5; }
    /usr/bin/rm -f -- "$committed_input"
    read_journal_held
    release_ordered_locks
  fi
    commit_result_from_journal "$(printf '%s' "$journal" | "$jq_bin" -r '.state')"
}

[[ -x $jq_bin && -x $base64_bin && -x $sha256_bin ]] || {
  printf '%s\n' '{"action":null,"operationId":null,"pluginId":null,"protocol":null,"reason":"unavailable-runtime","state":null,"status":"unavailable"}'
  printf 'omarchy-plugin-transaction: unavailable-runtime\n' >&2
  exit 4
}
[[ -x $native_helper && -f $request_validator && -f $journal_validator ]] ||
  emit_error unavailable unavailable-implementation 4
[[ $# == 0 ]] || emit_error invalid-request argv-not-accepted 2

request=""
if ! request=$(native_run json-request-check 2>/dev/null); then
  emit_error invalid-request malformed-request 2
fi
if ! printf '%s' "$request" | "$jq_bin" -e 'type == "object"' >/dev/null 2>&1; then
  emit_error invalid-request non-object-request 2
fi

request_protocol=$(json_field 'if (.protocol | type) == "string" and (.protocol | test("^[ -~]{1,128}$")) then .protocol else "" end')
request_action=$(json_field 'if (.action | type) == "string" and (.action | test("^[a-z-]{1,32}$")) then .action else "" end')
request_operation_id=$(json_field 'if (.operationId | type) == "string" and (.operationId | test("^[0-9A-Fa-f-]{1,64}$")) then .operationId else "" end')
request_plugin_id=$(json_field 'if (.pluginId | type) == "string" and (.pluginId | test("^[A-Za-z0-9._-]{1,128}$")) then .pluginId else "" end')

[[ $request_protocol == legacy-schema-v1-transaction/v1 ]] ||
  emit_error incompatible-request unsupported-protocol 2
case $request_action in
  capabilities|stage|status|abort|commit) ;;
  *) emit_error incompatible-request unsupported-action 2 ;;
esac
if ! printf '%s' "$request" | "$jq_bin" -e -f "$request_validator" >/dev/null 2>&1; then
  emit_error invalid-request invalid-request-schema 2
fi

if [[ $request_action == capabilities ]]; then
  unset request
  commit_supported=false
  if [[ -x $native_helper ]] && native_run atomic-support >/dev/null 2>&1; then commit_supported=true; fi
  "$jq_bin" -cnS --argjson commit "$commit_supported" '{protocol:"legacy-schema-v1-transaction/v1",
    capabilities:["legacy-schema-v1-transaction/v1"],
    actions:(if $commit then ["capabilities","stage","status","abort","commit"] else ["capabilities","stage","status","abort"] end),
    treeIdentityAlgorithms:["omarchy-runtime-tree-sha256-v1"],
    operations:["install","update"],
    referencePolicies:["require-unreferenced","preserve-observed"]}'
  exit 0
fi

[[ -n ${HOME:-} && $HOME == /* ]] || emit_error unavailable invalid-home-authority 4
if [[ -n ${XDG_STATE_HOME:-} && $XDG_STATE_HOME != /* ]]; then
  emit_error unavailable invalid-state-authority 4
fi
if ! state_root=$(/usr/bin/realpath -m -- \
    "${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/plugin-transactions-v1" 2>/dev/null); then
  emit_error unavailable invalid-state-authority 4
fi

if [[ $request_action == status ]]; then
  unset request
  if read_journal_authoritative; then
    emit_journal_response status
    exit 0
  fi
  if [[ $journal_read_error == operation-not-found ]]; then
    emit_error not-found operation-not-found 0
  fi
  if [[ $journal_read_error == durability-indeterminate ]]; then
    emit_error indeterminate journal-authority-indeterminate 5
  fi
  emit_error manual-attention invalid-state 4
fi

if ! candidate_store=$(/usr/bin/realpath -m -- \
    "${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/plugin-candidates-v1" 2>/dev/null) ||
    ! discovery_dir=$(/usr/bin/realpath -m -- "$HOME/.config/omarchy/plugins" 2>/dev/null); then
  emit_error unavailable invalid-path-authority 4
fi

operation_token=$(json_field '.operationToken')
validate_operation_token || {
  unset operation_token request
  emit_error invalid-request invalid-operation-token-encoding 2
}

if [[ $request_action == stage ]]; then
  [[ -x $stage_helper && -x $package_root/bin/omarchy-plugin-validate &&
      -f $observation_validator && -x $shell_client ]] || {
    unset operation_token request
    emit_error unavailable unavailable-implementation 4
  }
  operation_kind=$(json_field '.operation')
  source_path=$(json_field '.source.path')
  request_plugin_id=$(json_field '.pluginId')
  candidate_digest=$(json_field '.candidateTree.digest')
  candidate_identity=omarchy-runtime-tree-sha256-v1:${candidate_digest#sha256:}
  active_state=$(json_field '.expectedActive.state')
  if [[ $active_state == present ]]; then
    active_digest=$(json_field '.expectedActive.tree.digest')
    active_identity=omarchy-runtime-tree-sha256-v1:${active_digest#sha256:}
  else
    active_identity=""
  fi
  expected_config_kind=$(json_field '.expectedConfiguration.source.kind')
  expected_config_identity=$(json_field '.expectedConfiguration.source.identity')
  expected_projection=$(json_field '.expectedConfiguration.referenceProjectionSha256')
  expected_reference_state=$(json_field '.expectedConfiguration.referenceState')
  reference_policy=$(json_field '.expectedConfiguration.referencePolicy')
  if ! source_path=$(/usr/bin/realpath -m -- "$source_path" 2>/dev/null); then
    unset operation_token request
    emit_error rejected invalid-source 0
  fi
  destination=$discovery_dir/$request_plugin_id
  unset request

  if read_journal; then
    existing_capability=$(printf '%s' "$journal" | "$jq_bin" -r '.capabilityHash // ""')
    if [[ ! $existing_capability =~ ^[0-9a-f]{64}$ ]]; then
      unset operation_token existing_capability
      emit_error manual-attention manual-attention 4 MANUAL_ATTENTION
    fi
    if ! supplied_capability=$(printf '%s' "$operation_token" | native_run domain-hash \
        omarchy-plugin-transaction-capability/v1 2>/dev/null); then
      unset operation_token existing_capability supplied_capability
      emit_error unavailable local-io-failure 4
    fi
    if ! printf '%s' "$supplied_capability" | native_run hash-equal "$existing_capability"; then
      unset operation_token existing_capability supplied_capability
      emit_error rejected invalid-operation-token 3
    fi
    unset existing_capability supplied_capability
    existing_state=$(printf '%s' "$journal" | "$jq_bin" -r '.state')
    case $existing_state in
      STAGED|ABORTED) ;;
      REQUEST_BOUND|PUBLICATION_INTENT)
        operation_lock_path=$state_root/locks/operations/$request_operation_id.lock
        if [[ ! -f $operation_lock_path || -L $operation_lock_path ||
            $(stat -c '%h:%a' "$operation_lock_path" 2>/dev/null || true) != 1:600 ]]; then
          unset operation_token
          emit_error manual-attention invalid-state 4 "$existing_state"
        fi
        coproc STAGE_OPERATION_LOCK {
          native_run operation-lock "$state_root" "$request_operation_id" 2>/dev/null
        }
        stage_lock_read_fd=${STAGE_OPERATION_LOCK[0]}
        stage_lock_write_fd=${STAGE_OPERATION_LOCK[1]}
        stage_lock_pid=$STAGE_OPERATION_LOCK_PID
        if IFS= read -r -t "$lock_timeout_seconds" stage_lock_ready <&"$stage_lock_read_fd"; then
          :
        else
          stage_lock_read_status=$?
          exec {stage_lock_read_fd}<&-
          exec {stage_lock_write_fd}>&-
          wait "$stage_lock_pid" 2>/dev/null || true
          unset operation_token
          (( stage_lock_read_status == 142 )) && emit_error indeterminate lock-timeout 5 "$existing_state"
          emit_error unavailable lock-failure 4 "$existing_state"
        fi
        exec {stage_lock_read_fd}<&-
        if [[ $stage_lock_ready != locked-operation ]]; then
          exec {stage_lock_write_fd}>&-
          wait "$stage_lock_pid" 2>/dev/null || true
          unset operation_token
          emit_error unavailable lock-failure 4 "$existing_state"
        fi
        if ! read_journal_held; then
          exec {stage_lock_write_fd}>&-
          wait "$stage_lock_pid" 2>/dev/null || true
          unset operation_token
          if [[ $journal_read_error == durability-indeterminate ]]; then
            emit_error indeterminate journal-authority-indeterminate 5 "$existing_state"
          fi
          emit_error manual-attention invalid-state 4 "$existing_state"
        fi
        existing_state=$(printf '%s' "$journal" | "$jq_bin" -r '.state')
        exec {stage_lock_write_fd}>&-
        if ! wait "$stage_lock_pid"; then
          unset operation_token
          emit_error unavailable lock-failure 4 "$existing_state"
        fi
        case $existing_state in
          STAGED|ABORTED|REQUEST_BOUND|PUBLICATION_INTENT) ;;
          RECOVERY_REQUIRED)
            unset operation_token
            emit_error indeterminate recovery-required 5 "$existing_state"
            ;;
          MANUAL_ATTENTION)
            unset operation_token
            emit_error manual-attention manual-attention 4 "$existing_state"
            ;;
          *)
            unset operation_token
            emit_error manual-attention invalid-state 4
            ;;
        esac
        ;;
      RECOVERY_REQUIRED)
        unset operation_token
        emit_error indeterminate recovery-required 5 "$existing_state"
        ;;
      MANUAL_ATTENTION)
        unset operation_token
        emit_error manual-attention manual-attention 4 "$existing_state"
        ;;
      *)
        unset operation_token
        emit_error manual-attention invalid-state 4
        ;;
    esac
    stored_plugin=$(printf '%s' "$journal" | "$jq_bin" -r '.pluginId')
    stored_destination=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.destination')
    stored_source_kind=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedConfiguration.source.kind')
    stored_source_identity=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.expectedConfiguration.source.identity')
    stored_operation=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.operation')
    if [[ $stored_operation == install ]]; then
      [[ $stored_destination == "$discovery_dir/$stored_plugin" ]] || {
        unset operation_token
        emit_error manual-attention invalid-state 4 "$existing_state"
      }
    elif [[ $stored_operation == update ]]; then
      validate_update_destination "$stored_destination" || {
        unset operation_token
        emit_error manual-attention invalid-state 4 "$existing_state"
      }
    else
      unset operation_token
      emit_error manual-attention invalid-state 4 "$existing_state"
    fi
    destination=$stored_destination
    if [[ $stored_source_kind == user ]]; then
      [[ $stored_source_identity == omarchy-shell-config:user:v1 ]] || {
        unset operation_token
        emit_error manual-attention invalid-state 4 "$existing_state"
      }
    elif [[ $stored_source_kind == default ]]; then
      [[ $stored_source_identity == omarchy-shell-config:packaged-default:v1 ||
          $stored_source_identity == omarchy-shell-config:builtin-default:v1 ]] || {
        unset operation_token
        emit_error manual-attention invalid-state 4 "$existing_state"
      }
    else
      unset operation_token
      emit_error manual-attention invalid-state 4 "$existing_state"
    fi
    observation_source=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.stageObservation.provenance')
    [[ $observation_source == shell-authoritative-o7 ]] || {
      unset operation_token
      emit_error manual-attention invalid-state 4 "$existing_state"
    }
    observed_raw=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.stageObservation.rawSha256')
    observed_projection=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.stageObservation.referenceProjection')
    observed_reference_state=$(printf '%s' "$journal" | "$jq_bin" -r '.normalizedRequest.facts.stageObservation.referenceState')
    invoke_stage_candidate
    if ! read_journal_authoritative; then
      if [[ $journal_read_error == durability-indeterminate ]]; then
        emit_error indeterminate journal-authority-indeterminate 5
      fi
      emit_error manual-attention invalid-state 4
    fi
    emit_journal_response stage
    exit 0
  elif [[ $journal_read_error != operation-not-found ]]; then
    unset operation_token
    emit_error manual-attention invalid-state 4
  fi

  local_source=$(/usr/bin/realpath -e -- "$source_path" 2>/dev/null || true)
  if [[ -z $local_source || $local_source != "$source_path" || ! -d $source_path || -L $source_path ]]; then
    unset operation_token
    emit_error rejected invalid-source 0
  fi
  observed_candidate=$(native_run identity "$source_path" 2>/dev/null || true)
  if [[ $observed_candidate != "$candidate_identity" ]]; then
    unset operation_token
    emit_error rejected stale-candidate 0
  fi

  shell_environment=(/usr/bin/env -i "HOME=$HOME" "PATH=$PATH" "LC_ALL=C"
    "OMARCHY_PATH=$package_root" "OMARCHY_SHELL_IPC_TIMEOUT=5")
  for environment_name in XDG_CONFIG_HOME XDG_CACHE_HOME XDG_STATE_HOME XDG_RUNTIME_DIR; do
    [[ -z ${!environment_name:-} ]] || shell_environment+=("$environment_name=${!environment_name}")
  done
  if ! observation=$("${shell_environment[@]}" "$shell_client" shell \
      transactionStageObservation "$request_plugin_id" 2>/dev/null); then
    unset operation_token
    emit_error unavailable shell-authority-unavailable 4
  fi
  if ! observation=$(printf '%s' "$observation" | native_run json-request-check 2>/dev/null); then
    unset operation_token observation
    emit_error unavailable malformed-shell-observation 4
  fi
  if ! printf '%s' "$observation" | "$jq_bin" -e --arg plugin_id "$request_plugin_id" \
      -f "$observation_validator" >/dev/null 2>&1; then
    unset operation_token observation
    emit_error unavailable malformed-shell-observation 4
  fi
  if [[ $(printf '%s' "$observation" | "$jq_bin" -r '.valid') != true ]]; then
    unset operation_token observation
    emit_error unavailable shell-authority-not-ready 4
  fi

  observed_config_kind=$(printf '%s' "$observation" | "$jq_bin" -r '.configurationSource.kind')
  observed_config_identity=$(printf '%s' "$observation" | "$jq_bin" -r '.configurationSource.identity')
  observed_reference_state=$(printf '%s' "$observation" | "$jq_bin" -r '.referenceState')
  observed_active_state=$(printf '%s' "$observation" | "$jq_bin" -r '.activeDiscovery.state')
  observed_active_source=$(printf '%s' "$observation" | "$jq_bin" -r '.activeDiscovery.sourceDirectory // ""')
  raw_base64=$(printf '%s' "$observation" | "$jq_bin" -r '.rawBase64')
  projection_base64=$(printf '%s' "$observation" | "$jq_bin" -r '.referenceProjectionBase64')
  observed_discovery=$(printf '%s' "$observation" | "$jq_bin" -r '.discoveryDirectory')
  observed_state_root=$(printf '%s' "$observation" | "$jq_bin" -r '.transactionStateRoot')
  unset observation

  if ! raw_reencoded=$(printf '%s' "$raw_base64" | "$base64_bin" -d 2>/dev/null | "$base64_bin" -w0) ||
      [[ $raw_reencoded != "$raw_base64" ]]; then
    unset operation_token raw_base64 projection_base64 raw_reencoded
    emit_error unavailable malformed-shell-observation 4
  fi
  if ! projection_reencoded=$(printf '%s' "$projection_base64" | "$base64_bin" -d 2>/dev/null | "$base64_bin" -w0) ||
      [[ $projection_reencoded != "$projection_base64" ]]; then
    unset operation_token raw_base64 projection_base64 projection_reencoded
    emit_error unavailable malformed-shell-observation 4
  fi
  observed_raw=sha256:$(printf '%s' "$raw_base64" | "$base64_bin" -d | "$sha256_bin" | /usr/bin/cut -d' ' -f1)
  observed_projection=sha256:$(printf '%s' "$projection_base64" | "$base64_bin" -d | "$sha256_bin" | /usr/bin/cut -d' ' -f1)
  unset raw_base64 projection_base64 raw_reencoded projection_reencoded

  [[ $observed_config_kind == "$expected_config_kind" &&
      $observed_config_identity == "$expected_config_identity" ]] || {
    unset operation_token
    emit_error rejected stale-configuration-source 0
  }
  [[ $observed_reference_state == "$expected_reference_state" ]] || {
    unset operation_token
    if [[ $reference_policy == require-unreferenced ]]; then
      emit_error rejected require-unreferenced-violation 0
    fi
    emit_error rejected stale-reference-state 0
  }
  [[ $observed_projection == "$expected_projection" ]] || {
    unset operation_token
    emit_error rejected stale-reference-projection 0
  }
  observed_discovery=$(/usr/bin/realpath -e -- "$observed_discovery" 2>/dev/null || true)
  observed_state_root=$(/usr/bin/realpath -e -- "$observed_state_root" 2>/dev/null || true)
  [[ -n $observed_discovery && -d $observed_discovery && ! -L $observed_discovery &&
      $observed_discovery == "$discovery_dir" && -n $observed_state_root &&
      -d $observed_state_root && ! -L $observed_state_root && $observed_state_root == "$state_root" ]] || {
    unset operation_token
    emit_error unavailable shell-authority-mismatch 4
  }
  if [[ $active_state == absent ]]; then
    destination=$observed_discovery/$request_plugin_id
    if [[ $observed_active_state != absent || -e $destination || -L $destination ]]; then
      unset operation_token
      emit_error rejected stale-active-tree 0
    fi
  else
    if [[ $observed_active_state != present ]]; then
      unset operation_token
      emit_error rejected stale-active-tree 0
    fi
    if [[ -z $observed_active_source || -L $observed_active_source ]]; then
      unset operation_token
      emit_error rejected stale-active-tree 0
    fi
    observed_active_source=$(/usr/bin/realpath -e -- "$observed_active_source" 2>/dev/null || true)
    if [[ -z $observed_active_source ]] || ! validate_update_destination "$observed_active_source"; then
      unset operation_token
      emit_error rejected stale-active-tree 0
    fi
    destination=$observed_active_source
    observed_manifest_id=""
    if [[ -f $destination/manifest.json && ! -L $destination/manifest.json ]]; then
      observed_manifest_id=$("$jq_bin" -er '.id | select(type == "string")' \
        "$destination/manifest.json" 2>/dev/null || true)
    fi
    if [[ $observed_manifest_id != "$request_plugin_id" ]]; then
      unset operation_token observed_manifest_id
      emit_error rejected stale-active-tree 0
    fi
    unset observed_manifest_id
    observed_active=$(native_run identity "$destination" 2>/dev/null || true)
    if [[ $observed_active != "$active_identity" ]]; then
      unset operation_token
      emit_error rejected stale-active-tree 0
    fi
  fi

  observation_source=shell-authoritative-o7
  invoke_stage_candidate
  if ! read_journal_authoritative; then
    emit_error manual-attention invalid-state 4
  fi
  emit_journal_response stage
  exit 0
fi

if [[ $request_action == commit ]]; then
  [[ -x $shell_client && -x $native_helper && -f $journal_validator && -f $gate_validator ]] ||
    emit_error unavailable unavailable-implementation 4
  commit_operation
fi

# The remaining action is abort. Read the exact journal before deriving its
# package-owned plugin lock, but reveal no journal fact until capability check.
unset request
if ! read_journal_authoritative; then
  unset operation_token
  if [[ $journal_read_error == operation-not-found ]]; then
    emit_error not-found operation-not-found 0
  fi
  if [[ $journal_read_error == durability-indeterminate ]]; then
    emit_error indeterminate journal-authority-indeterminate 5
  fi
  emit_error manual-attention invalid-state 4
fi
stored_capability=$(printf '%s' "$journal" | "$jq_bin" -r '.capabilityHash // ""')
if [[ ! $stored_capability =~ ^[0-9a-f]{64}$ ]]; then
  unset operation_token stored_capability
  emit_error manual-attention manual-attention 4 MANUAL_ATTENTION
fi
if ! capability_hash=$(printf '%s' "$operation_token" | native_run domain-hash \
    omarchy-plugin-transaction-capability/v1 2>/dev/null); then
  unset operation_token stored_capability capability_hash
  emit_error unavailable local-io-failure 4
fi
unset operation_token
if ! printf '%s' "$capability_hash" | native_run hash-equal "$stored_capability"; then
  unset capability_hash stored_capability
  emit_error rejected invalid-operation-token 3
fi
request_plugin_id=$(printf '%s' "$journal" | "$jq_bin" -r '.pluginId // ""')
[[ -n $request_plugin_id ]] || {
  unset capability_hash stored_capability
  emit_error manual-attention manual-attention 4 MANUAL_ATTENTION
}

coproc TRANSACTION_LOCK {
  native_run ordered-lock "$state_root" "$request_operation_id" "$request_plugin_id" 2>/dev/null
}
lock_read_fd=${TRANSACTION_LOCK[0]}
lock_write_fd=${TRANSACTION_LOCK[1]}
lock_pid=$TRANSACTION_LOCK_PID
if IFS= read -r -t "$lock_timeout_seconds" lock_ready <&"$lock_read_fd"; then
  :
else
  lock_read_status=$?
  exec {lock_read_fd}<&-
  exec {lock_write_fd}>&-
  set +e
  wait "$lock_pid" 2>/dev/null
  lock_holder_status=$?
  set -e
  unset capability_hash stored_capability
  (( lock_read_status != 142 && lock_holder_status == 3 )) &&
    emit_error in-progress operation-in-progress 0
  (( lock_read_status == 142 )) && emit_error indeterminate lock-timeout 5
  emit_error unavailable lock-failure 4
fi
exec {lock_read_fd}<&-
[[ $lock_ready == locked-operation-then-plugin ]] || {
  exec {lock_write_fd}>&-
  wait "$lock_pid" 2>/dev/null || true
  unset capability_hash stored_capability
  emit_error unavailable lock-failure 4
}

if ! read_journal_held; then
  unset capability_hash stored_capability
  if [[ $journal_read_error == durability-indeterminate ]]; then
    emit_error indeterminate journal-authority-indeterminate 5
  fi
  emit_error manual-attention invalid-state 4
fi
[[ $(printf '%s' "$journal" | "$jq_bin" -r '.pluginId // ""') == "$request_plugin_id" ]] || {
  unset capability_hash stored_capability
  emit_error manual-attention invalid-state 4
}
current_capability=$(printf '%s' "$journal" | "$jq_bin" -r '.capabilityHash // ""')
if ! printf '%s' "$capability_hash" | native_run hash-equal "$current_capability"; then
  unset capability_hash stored_capability current_capability
  emit_error manual-attention invalid-state 4
fi
unset capability_hash stored_capability current_capability

durable_state=$(printf '%s' "$journal" | "$jq_bin" -r '.state')
case $durable_state in
  STAGED|ABORTED) ;;
  REQUEST_BOUND|PUBLICATION_INTENT)
    emit_error in-progress operation-in-progress 0 "$durable_state"
    ;;
  RECOVERY_REQUIRED)
    emit_error indeterminate recovery-required 5 "$durable_state"
    ;;
  MANUAL_ATTENTION)
    emit_error manual-attention manual-attention 4 "$durable_state"
    ;;
  *) emit_error manual-attention invalid-state 4 ;;
esac

gate_path=$state_root/gates/$request_plugin_id.gate
if [[ -e $gate_path || -L $gate_path ]]; then
  emit_error in-progress operation-in-progress 0 "$durable_state"
fi
case "$candidate_store/" in
  "$discovery_dir/"*) emit_error manual-attention invalid-state 4 "$durable_state" ;;
esac
candidate_path=$candidate_store/$request_operation_id/candidate
expected_candidate=$(printf '%s' "$journal" | "$jq_bin" -r '.candidate.observed // ""')
if [[ ! -d $candidate_path || -L $candidate_path ||
    $(native_run identity "$candidate_path" 2>/dev/null || true) != "$expected_candidate" ]]; then
  emit_error manual-attention invalid-state 4 "$durable_state"
fi

if [[ $durable_state == ABORTED ]]; then
  emit_journal_response abort
  exec {lock_write_fd}>&-
  wait "$lock_pid"
  exit 0
fi

if ! journal_input=$(/usr/bin/mktemp /tmp/omarchy-plugin-abort-journal.XXXXXX); then
  emit_error unavailable local-io-failure 4 "$durable_state"
fi
if ! printf '%s' "$journal" | "$jq_bin" -cS \
    '.state="ABORTED" | .reason="owner-aborted"' >"$journal_input" ||
    ! chmod 0600 "$journal_input"; then
  emit_error unavailable local-io-failure 4 "$durable_state"
fi
if ! "$jq_bin" -eS --arg operation_id "$request_operation_id" \
    -f "$journal_validator" "$journal_input" >/dev/null; then
  emit_error manual-attention invalid-generated-state 4 "$durable_state"
fi
if ! native_run journal-replace "$state_root" "$request_operation_id" \
    "$journal_input" staged-to-aborted >/dev/null 2>&1; then
  emit_error indeterminate abort-indeterminate 5
fi
if ! read_journal_held || [[ $(printf '%s' "$journal" | "$jq_bin" -r '.state') != ABORTED ]]; then
  emit_error indeterminate abort-indeterminate 5
fi
emit_journal_response abort
exec {lock_write_fd}>&-
wait "$lock_pid"
