#!/bin/bash
set -euo pipefail

# Isolated offscreen harness selector.  The production helper intentionally
# filters IPC instances by display; this test-only selector uses the exact
# copied shell path and --any-display because the offscreen QPA has no desktop
# display identity.  It still invokes the real QML shell and IPC handlers.
[[ -n ${OMARCHY_PATH:-} && -f $OMARCHY_PATH/shell/shell.qml ]] || exit 1
replay_root="${XDG_RUNTIME_DIR:-}/omarchy-o8-replay"
replay_operation=$(cat "$replay_root/operation" 2>/dev/null || true)
replay_plugin=$(cat "$replay_root/plugin" 2>/dev/null || true)
journal_state=""
if [[ -n $replay_operation ]]; then
  journal_state=$(jq -r .state "$XDG_STATE_HOME/omarchy/plugin-transactions-v1/journals/$replay_operation.journal" 2>/dev/null || true)
fi
if [[ -e $replay_root/hold-before-rescan && ${2:-} == rescanGatedPlugin && ${3:-} == "$replay_operation" ]]; then
  : >"$replay_root/before-rescan-ready"
  IFS= read -r _ <"$replay_root/before-rescan-resume"
fi
if [[ -e $replay_root/hold-after-rescan && $journal_state == GATED_RESCAN_COMPLETED && ${2:-} == transactionStageObservation && ${3:-} == "$replay_plugin" ]]; then
  : >"$replay_root/after-rescan-ready"
  IFS= read -r _ <"$replay_root/after-rescan-resume"
fi
if [[ -e $replay_root/hold-before-release && ${2:-} == releaseTransactionPlugin && ${3:-} == "$replay_operation" ]]; then
  : >"$replay_root/before-release-ready"
  IFS= read -r _ <"$replay_root/before-release-resume"
fi
fail_gated_rescan=${OMARCHY_LIFECYCLE_FAIL_GATED_RESCAN:-${XDG_RUNTIME_DIR:-}/omarchy-fail-gated-rescan}
if [[ ${2:-} == rescanGatedPlugin && -e $fail_gated_rescan ]]; then
  rm -f -- "$fail_gated_rescan"
  exit 70
fi
rollback_root="${XDG_RUNTIME_DIR:-}/omarchy-o8-rollback-fresh"
if [[ ${2:-} == "rescanRollbackPlugin" && -f "$rollback_root/operation" &&
  ${3:-} == "$(<"$rollback_root/operation")" ]]; then
  # Hold before sending to QML, after the coordinator's durable restoration.
  if [[ -e "$rollback_root/hold-before-rescan" ]]; then
    : >"$rollback_root/before-rescan-ready"
    IFS= read -r _ <"$rollback_root/before-rescan-resume"
  fi
  printf '%s %s %s\n' "$3" "$2" "$BASHPID" >>"$rollback_root/rescan-dispatches"
fi
load_root="${XDG_RUNTIME_DIR:-}/omarchy-o8-load-gated"
if [[ ${2:-} == "transactionStageObservation" && -f "$load_root/observe-replay" &&
  ${3:-} == "$(<"$load_root/observe-replay")" ]]; then
  # Observe the actual production IPC response without manufacturing or
  # altering authority. Retain no request, bearer token, or environment.
  status=0
  observation_started=$EPOCHREALTIME
  timeout --kill-after=1s "${OMARCHY_SHELL_IPC_TIMEOUT:-5s}" \
    qs ipc -n --any-display -p "$OMARCHY_PATH/shell" call -- "$@" \
    >"$load_root/replay-observation.json" || status=$?
  printf '%s %s %s %s\n' "$observation_started" "$EPOCHREALTIME" "$status" \
    "${OMARCHY_SHELL_IPC_TIMEOUT:-5s}" >"$load_root/observation-timing"
  if [[ -e "$load_root/truncate-observation" && $status == 0 ]]; then
    # Transport fault only: retain the real producer response, then remove its
    # closing brace. Never substitute a fabricated valid authority object.
    rm "$load_root/truncate-observation"
    observation=$(<"$load_root/replay-observation.json")
    printf '%s' "${observation%?}" >"$load_root/transport-observation"
    cat "$load_root/transport-observation"
    exit 0
  fi
  cat "$load_root/replay-observation.json"
  exit "$status"
fi
exec timeout --kill-after=1s "${OMARCHY_SHELL_IPC_TIMEOUT:-5s}" \
  qs ipc -n --any-display -p "$OMARCHY_PATH/shell" call -- "$@"
